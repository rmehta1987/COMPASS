            "quoted_wording": "sha256:5c211e315544228b7bfcc72d908921996b65b5bd80e7b9c61b6464f8d5711c69"
          },
          "mechanism": "While hay fever itself is the clinical indication for antihistamine use, the age at which hay fever was first diagnosed is a demographic artifact reflecting healthcare access at a point in time, not a causal determinant of adult antihistamine dosing or cirrhosis diagnosis timing. Current allergy status and treatment behavior are captured by m2:Q11.7.",
          "justification": "Not a cause of either the exposure measure (daily pill count) or the outcome (age at cirrhosis diagnosis).",
          "role": "not_a_cause_of_either",
          "proxy_for": null,
          "contestable": false
        }
