      "model_spec": {
        "form": "Linear regression of age at cirrhosis diagnosis on antihistamine pill count quintile (binary: highest vs. lowest), adjusted for covariates listed above. Response variable is continuous (age in years); exposure is binary comparison of quintiles.",
        "unit_of_analysis": "participant",
        "clustering": "Cluster-robust standard errors or generalized estimating equations with community area as the cluster unit"
