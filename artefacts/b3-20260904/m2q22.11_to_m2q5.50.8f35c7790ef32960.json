      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q1.8",
            "quoted_wording": "sha256:dd506fb26782a15e8b85ef427d7c49a15e1f410cad8f95d65022706f7d14555f"
          },
          "mechanism": "Sex at birth is associated with both OTC medication use patterns (women use antihistamines more frequently) and cirrhosis diagnosis patterns (sex differences in alcohol-related liver disease incidence and disease presentation).",
          "justification": "Confounding by a common cause.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.28",
            "quoted_wording": "sha256:afb21ffe06fa68347d4c87cb990bbfb3a2591a24f19b3cc50f1ee9fe1810ecf1"
          },
          "mechanism": "Hepatitis B and C infection are major independent risk factors for cirrhosis development. Hepatitis status may also correlate with medication use patterns (e.g., health-seeking behavior leading to antihistamine use). Controlling for hepatitis status separates antihistamine effects on hepatitis-related cirrhosis from other etiologies.",
          "justification": "Confounding by hepatitis status, which independently determines cirrhosis risk and may correlate with healthcare engagement and OTC medication use.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.6",
            "quoted_wording": "sha256:883085f9e05c1ff52e186d0ca76208723c1d81024663315e7f20b7cc5c94c2d4"
          },
          "mechanism": "Type 2 diabetes is independently associated with liver disease (fatty liver, advanced fibrosis) and may predict cirrhosis risk. Diabetes also correlates with healthcare-seeking behavior and medication use patterns.",
          "justification": "Confounding by diabetes status.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q11.7",
            "quoted_wording": "sha256:314933774bd221d1e8c65417da45c84aef2fe0a4ad051519dac72772b993b8f1"
          },
          "mechanism": "Allergies are the primary clinical indication for antihistamine use; allergy treatment history indicates both predisposition to antihistamine use and presence of an allergic phenotype.",
          "justification": "Precision gain by conditioning on the reason for exposure.",
          "role": "cause_of_exposure_only",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q19.24",
            "quoted_wording": "sha256:bb78adaabdbb0aed9cfd789c3e5ac9c8a59c695f8d218ea53795f3946cbeafb3"
          },
          "mechanism": "Ibuprofen use indicates general OTC medication-taking behavior. NSAIDs are also hepatotoxic and may independently affect liver disease risk. People who use antihistamines regularly are more likely to use multiple OTC medications concurrently.",
          "justification": "Confounding by concurrent OTC medication use.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q19.46",
            "quoted_wording": "sha256:d7aab90e7c71bcb93120751d16464b10df0beb893092511d09d012d4515a39f4"
          },
          "mechanism": "Same as ibuprofen—indicates OTC medication use patterns and potential hepatotoxicity.",
          "justification": "Confounding by concurrent OTC medication use.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q19.35",
            "quoted_wording": "sha256:6c1c4cca2535386576966e6c43b362771413ac518415ba0d2573aed3ab204e0f"
          },
          "mechanism": "Acetaminophen is the OTC analgesic with the strongest established hepatotoxic potential, especially at cumulative doses and in combination with alcohol. People who use antihistamines regularly may also use acetaminophen. Acetaminophen use independently predicts cirrhosis risk.",
          "justification": "Confounding by concurrent hepatotoxic medication use.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
