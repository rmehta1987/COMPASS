          },
          "mechanism": "Current antihypertensive medication use is a direct descendant and mechanical consequence of the historical duration of medication use measured by the outcome.",
          "justification": "Including current medication status creates post-treatment bias; someone on antihypertensive medications for many years is almost certain to currently use them, making this variable mechanistically dependent on the outcome.",
          "role": "descendant_of_outcome",
          "proxy_for": null,
          "contestable": false
        }
