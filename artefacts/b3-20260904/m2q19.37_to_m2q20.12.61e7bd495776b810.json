      "question": "Does the frequency of regular acetaminophen use predict the duration of antihypertensive medication treatment?",
      "exposure": {
        "kind": "variable",
        "key": "m2:Q19.37",
        "quoted_wording": "sha256:3ce9e4f24f9162e25272a153b6b46ea747135370a028dac6b3f929e598f35334"
