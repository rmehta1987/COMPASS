      "dictionary_version": "3dc8415eccfe",
      "question": "Does self-reported history of regular insulin use associate with age at diagnosis of celiac disease or gluten sensitivity?",
      "exposure": {
        "kind": "variable",
        "key": "m2:Q23.15",
        "quoted_wording": "sha256:fc2a40d29ba418ea6e16fa27b8f8045f5a9ee92ecadf18d6c52269de3e0ddfab"
      },
      "outcome": {
        "kind": "variable",
        "key": "m2:Q5.26",
        "quoted_wording": "sha256:9863c97472c3ad645a0cfb303e852e5a56540236f564da3c71f416b8ded80c19"
      },
      "expected_direction": {
        "direction": "increase",
        "magnitude": null,
        "magnitude_source": null
      },
      "falsifier": "The null hypothesis is that insulin use history does not associate with age at celiac diagnosis after adjusting for autoimmune tendency, diabetes type, and demographic confounders. A true association would manifest as a difference in mean age at celiac diagnosis between insulin users and non-users, or a difference in celiac disease prevalence between groups at comparable ages.",
      "falsifier_threshold": {
        "value": 10.0,
        "unit": "percentage points",
        "comparator": ">="
      },
      "model_spec": {
        "form": "Linear or logistic regression with cluster-robust standard errors stratified by community area",
        "unit_of_analysis": "participant",
        "clustering": "by community area"
      },
      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.3",
            "quoted_wording": "sha256:1502a55645513419f8997fa1a3261928116635487d10c83882c7b7ce91cc61fa"
          },
          "mechanism": "Both Type 1 diabetes and celiac disease show marked sex differences in prevalence, age of onset, and clinical presentation; sex determines biological exposure to sex hormones (estrogen dominance in females may amplify autoimmune responses) and affects healthcare-seeking behavior and screening patterns.",
          "justification": "Sex is a confounder that causes variation in both likelihood of insulin use and age at celiac diagnosis.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.10",
            "quoted_wording": "sha256:780728bf35035558d044eb83b0a0913fa9ac23432800ba7771332210ddb7cedd"
          },
          "mechanism": "Prevalence of Type 1 diabetes and celiac disease vary substantially across racial and ethnic groups; race/ethnicity also correlates with healthcare access, screening likelihood, and clinical recognition of autoimmune conditions.",
          "justification": "Race/ethnicity is a confounder that operates through both biological and healthcare access pathways.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q2.15_3",
            "quoted_wording": "sha256:ad7c805a862e7b7a8108d049792b0ac9c0565ecf18fb6bd6180854a61aed5e2c"
          },
          "mechanism": "Current age determines the time window during which celiac disease diagnosis could occur; a 50-year-old has had 50 years for diagnosis while a 20-year-old has had 20 years. Current age also correlates with cumulative lifetime risk of insulin use onset.",
          "justification": "Age is a confounder and precision variable because both insulin use history and celiac diagnosis age are age-dependent.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.4",
            "quoted_wording": "sha256:06f26b3aeabb79ed39bb2db875106fa6274622a3256efef6a48f1c1f55525305"
          },
          "mechanism": "Type 1 diabetes is autoimmune and shares biological pathways with celiac disease; Type 1 diabetes diagnosis is a key predictor of insulin use because Type 1 patients require insulin.",
          "justification": "Type 1 diabetes status is both a confounder (marker of autoimmune tendency) and necessary for mechanistic precision to separate autoimmune from metabolic pathways.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.6",
            "quoted_wording": "sha256:55600e24b14333ff4c2cea0d744d84df721ba906ace8329551ba8072ef427427"
          },
          "mechanism": "Type 2 diabetes is distinct from celiac disease etiologically (metabolic, not autoimmune); some Type 2 patients progress to insulin use. Including Type 2 status allows separation of autoimmune from metabolic pathways.",
          "justification": "Type 2 status is a precision variable to distinguish mechanisms and improve specificity of the autoimmune pathway.",
          "role": "precision",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.5",
            "quoted_wording": "sha256:d937c9a5e0752b7d4dca9e10a5da07320f475c90f87509f9651ee7784ee965cc"
          },
          "mechanism": "Early onset of Type 1 diabetes indicates entry into autoimmune disease trajectory early in life; both early T1D onset and early celiac onset correlate with genetic autoimmune susceptibility. Individuals with early-onset T1D have had longer exposure to the autoimmune environment.",
          "justification": "Age at T1D diagnosis is a confounder because it marks early activation of the autoimmune system.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.7",
            "quoted_wording": "sha256:feb48f11c86453b98ad0851786a09c58f9d1e8e132724ccd7d6ea779c5a96e39"
          },
          "mechanism": "Age at Type 2 diabetes diagnosis reflects metabolic aging and time of insulin initiation (later in Type 2 disease course), affecting both likelihood of current insulin use and age-related baseline risk for other conditions.",
          "justification": "Age at T2D diagnosis is a confounder for temporal patterning and insulin use recency.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.21",
            "quoted_wording": "sha256:3a097c0aa537d50e16158ddae33a50919dc52803eb1138fc498527c0d87a2c02"
          },
          "mechanism": "Other autoimmune conditions are markers of underlying immune dysregulation (autoimmune diathesis) that predisposes to multiple autoimmune diseases; age at diagnosis of other autoimmune disorders indicates when the person's immune dysfunction became clinically apparent.",
          "justification": "Autoimmune disorder history is a confounder because it proxies for autoimmune susceptibility and correlates with both exposure and outcome.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.20",
            "quoted_wording": "sha256:cab2a4842a03d48ce8b63052a7db8b628e3ed6033b26ff3ac11bcded10178dd7"
          },
          "mechanism": "While arthritis is autoimmune, it is not a recognized component of the shared pathophysiology linking Type 1 diabetes and celiac disease. Arthritis prevalence increases with age and is more common in Type 2 diabetes through obesity pathways.",
          "justification": "Arthritis is not a cause of the exposure (insulin use) or outcome (celiac diagnosis age) through relevant mechanisms; it would add noise rather than reduce confounding.",
          "role": "not_a_cause_of_either",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.62",
            "quoted_wording": "sha256:9aad795c7de74a5ec241cf93a6b7c1bede47167e87fdfb9a297a93f506eac99a"
          },
          "mechanism": "Thyroid disease is common in both Type 1 diabetes and celiac disease due to shared autoimmune pathways, but it is likely a descendant (mediator) of the same underlying autoimmune susceptibility rather than a confounder. Adjusting for thyroid disease would partial out the autoimmune signal.",
          "justification": "Thyroid disease is a potential mediator of the exposure-outcome relationship; including it in the model would inappropriately adjust away the causal pathway of interest.",
          "role": "descendant_of_exposure",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "undetermined_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.11",
            "quoted_wording": "sha256:45f00b152c1b85953fc15fb60065f1ca1ffffc566a72d7902ecca4f602786ef1"
          },
          "mechanism": "Education is a proxy for health literacy and healthcare engagement; higher education correlates with proactive health-seeking behavior and more thorough medical screening. Education could confound if it affects both likelihood of receiving an insulin prescription and likelihood of celiac diagnosis.",
          "justification": "Causal mechanism is unclear; education could be confounder or mediator depending on healthcare system context and whether it affects screening directly or through post-diagnosis engagement.",
          "role": "confounder_or_mediator",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q5.4",
            "quoted_wording": "sha256:79590ca38c808b483369e51527ceca6aca100f2472a404c51b46d36b4411c743"
          },
          "mechanism": "Household income is a proxy for socioeconomic status and healthcare access; income affects ability to afford diabetes management, healthcare utilization, and screening for other conditions. However, the specific pathway by which income confounds the insulin-celiac relationship is not clear without stratification data.",
          "justification": "Socioeconomic proxy with plausible but unconfirmed confounding mechanism; marked for sensitivity analysis without firm causal adjudication.",
          "role": "unadjudicated",
          "proxy_for": null,
          "contestable": false
        }
      ],
