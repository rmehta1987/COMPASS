          },
          "mechanism": "Autoimmune diseases cause chronic pain (leading to opioid use) and increase thrombotic risk through systemic inflammation and vascular injury.",
          "justification": "Autoimmune disorders cause both exposure and outcome.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.29",
