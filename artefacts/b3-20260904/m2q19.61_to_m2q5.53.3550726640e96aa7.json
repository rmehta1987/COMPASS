      "dictionary_version": "3dc8415eccfe",
      "question": "Does the duration of regular Celebrex (celecoxib) use affect the age at which a person is first diagnosed with migraine?",
      "exposure": {
        "kind": "variable",
        "key": "m2:Q19.61",
        "quoted_wording": "sha256:4de2ea8c15ae4390e7ba43c1131b08486fff82f3534a1b568f740306c89fb3d6"
      },
      "outcome": {
        "kind": "variable",
        "key": "m2:Q5.53",
        "quoted_wording": "sha256:6aee6ec5a86d1e1808a5d2e1270363d473b6cb7a90a7aae5c35785422f9c7a35"
      },
      "expected_direction": {
        "direction": "no_difference",
        "magnitude": null,
        "magnitude_source": null
      },
      "falsifier": "After adjusting for sex, arthritis history, race/ethnicity, Hispanic/Latino ethnicity, anxiety/panic/PTSD/phobia history, and work stress, the study fails to falsify the null if there is no statistically significant association between duration of regular Celebrex use and age at first migraine diagnosis, or if the magnitude of association is below a biologically plausible threshold.",
      "falsifier_threshold": null,
      "model_spec": {
        "form": "Linear regression, outcome is continuous (age in years)",
        "unit_of_analysis": "participant",
        "clustering": "Cluster-robust standard errors at the community area level"
      },
      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.3",
            "quoted_wording": "sha256:1502a55645513419f8997fa1a3261928116635487d10c83882c7b7ce91cc61fa"
          },
          "mechanism": "Sex is a cause of migraine outcome (migraine prevalence substantially higher in females) and is associated with patterns of NSAID use and healthcare-seeking behavior.",
          "justification": "Sex confounds the exposure-outcome relationship through both biological (migraine prevalence) and behavioral (medication use) pathways.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.20",
            "quoted_wording": "sha256:cab2a4842a03d48ce8b63052a7db8b628e3ed6033b26ff3ac11bcded10178dd7"
          },
          "mechanism": "Arthritis is a primary clinical indication for Celebrex use; arthritis itself is an inflammatory condition that may be associated with migraine pathophysiology or diagnostic patterns.",
          "justification": "Arthritis likely causes or strongly influences Celebrex exposure. Inflammatory conditions may cluster phenotypically with migraine. Without controlling for arthritis, the Celebrex-migraine association would reflect partly the arthritis-migraine association.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.10",
            "quoted_wording": "sha256:780728bf35035558d044eb83b0a0913fa9ac23432800ba7771332210ddb7cedd"
          },
          "mechanism": "Race/ethnicity reflects patterns in healthcare access, quality, diagnostic intensity, and medication availability, affecting both the likelihood of Celebrex use being documented and the likelihood of migraine diagnosis.",
          "justification": "In multiethnic cohort studies, racial/ethnic disparities in healthcare affect detection and documentation of both medications and diagnoses. COMPASS is a multiethnic study, making this adjustment necessary to separate true exposure-outcome effects from healthcare access confounding.",
          "role": "precision",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.8",
            "quoted_wording": "sha256:a10a496fc05ed9ee27e352d585b73564c6380fa93220d96d5bb1bf12b34e95e6"
          },
          "mechanism": "Ethnicity (distinct from race) may indicate distinct patterns of healthcare seeking, communication, and medication utilization.",
          "justification": "Ethnicity can modify healthcare pathways independent of race classification. In a multiethnic study, separate documentation of Hispanic/Latino identity captures additional heterogeneity in healthcare engagement.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.18",
            "quoted_wording": "sha256:9b99356b9e919aeea0d6bf9fcc84627f9f8cb7128bf188cd97c33abc5ded3191"
          },
          "mechanism": "Anxiety disorders are comorbid with migraines; anxiety increases pain sensitivity and the propensity to seek pain relief (including NSAID use). Anxiety is also associated with healthcare-seeking behavior and symptom reporting.",
          "justification": "Anxiety is a cause of both increased NSAID use (to manage anxiety-related tension and pain) and increased migraine diagnosis (anxiety and migraine co-occur; anxiety increases symptom reporting).",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q4.6",
            "quoted_wording": "sha256:d3ba7fa6df60f4eb26633da3e41466a52153847dac6998899abf50bbce995edb"
          },
          "mechanism": "Work stress triggers pain conditions (muscle tension, headaches) and migraines. Stress increases propensity to use pain-relief medications including NSAIDs.",
          "justification": "Stress is a common causal factor for both NSAID use (in response to tension and pain) and migraine diagnosis (stress is a migraine trigger).",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q19.28",
            "quoted_wording": "sha256:d8459274d2310d358ff7ce00966922cac3bb26c070b4118d925c7662faa14f8d"
          },
          "mechanism": "Ibuprofen is a competing NSAID medication on the same causal pathway as Celebrex (both are pain relief medications).",
          "justification": "Arthritis (m2:Q5.20) already captures the primary indication for NSAID use. Including multiple NSAIDs would add multicollinearity without closing additional confounding pathways. The exposure of interest is Celebrex specifically, not general NSAID class.",
          "role": "not_a_cause_of_either",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q19.50",
            "quoted_wording": "sha256:6c35145c01fb29b84dabefef0f9c61ad4aa593177f7846288bc85a7e3ce62961"
          },
          "mechanism": "Naproxen is another competing NSAID on the same causal pathway.",
          "justification": "Same as ibuprofen—redundant with arthritis indication and would create multicollinearity.",
          "role": "not_a_cause_of_either",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.30",
            "quoted_wording": "sha256:1b3efc7594d0cc4d06035229a893f6e98f899e0e4a4c97c79830a2e86d15b990"
          },
          "mechanism": "Depression is related to anxiety and is comorbid with migraines.",
          "justification": "Depression and anxiety are related conditions with overlapping associations to migraine and NSAID use. Including both creates multicollinearity. Anxiety (m2:Q5.18) is selected as the primary mental health confounder; depression adjustment is redundant given anxiety control.",
          "role": "not_a_cause_of_either",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.58",
            "quoted_wording": "sha256:3900ff495e9a7c30027b31c5e392031014bf5325a26d4ae05749c1901f0e2bef"
          },
          "mechanism": "Rheumatoid arthritis is a subtype of arthritis.",
          "justification": "Rheumatoid arthritis overlaps substantially with general arthritis diagnosis (m2:Q5.20). Including both creates redundancy and multicollinearity. General arthritis is selected as the primary arthritis confounder.",
          "role": "not_a_cause_of_either",
          "proxy_for": null,
          "contestable": false
        }
      ],
