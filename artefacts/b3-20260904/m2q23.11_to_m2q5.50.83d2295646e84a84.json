      "question": "Does higher daily insulin dose associate with earlier age at liver cirrhosis diagnosis in individuals taking insulin regularly?",
      "exposure": {
        "kind": "variable",
        "key": "m2:Q23.11",
        "quoted_wording": "sha256:43072a3dd07d98299cdf6c2bc4e17f02034cb51f1ae8c629b850cc7e709ab092"
      },
      "outcome": {
        "kind": "variable",
