            "quoted_wording": "sha256:3ab471fa287dd2c642ffa855b987d09bee149d8c32f050592780fe097c97032a"
          },
          "mechanism": "Years on insulin regularly. Longer duration predicts higher current insulin dose through tolerance and disease progression, and older age at future diagnoses.",
          "justification": "This variable is closely related to the measurement and mechanism of the exposure. Persons who have taken insulin for many years likely take higher doses. Excluding it avoids over-adjustment to the exposure mechanism.",
          "role": "descendant_of_exposure",
          "proxy_for": null,
          "contestable": false
        }
      ],
