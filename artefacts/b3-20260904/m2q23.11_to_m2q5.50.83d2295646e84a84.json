      },
      "expected_direction": {
        "direction": "decrease",
        "magnitude": null,
        "magnitude_source": null
      },
      "falsifier": "A regression coefficient from linear regression indicating that a 10-unit per day increase in daily insulin dose is associated with a meaningful change (at least 2–3 years earlier age at diagnosis, or smaller if clinically plausible; exact threshold to be determined) in age at liver cirrhosis diagnosis, after adjustment for confounders.",
      "falsifier_threshold": null,
      "model_spec": {
        "form": "Ordinary least squares linear regression with continuous outcome (age at cirrhosis diagnosis, in years) and continuous exposure (insulin dose, units per day), adjusted for the covariate set",
        "unit_of_analysis": "participant",
        "clustering": "Community area (per COMPASS design convention). Standard errors cluster-robust at the community area level."
      },
      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.4",
            "quoted_wording": "sha256:06f26b3aeabb79ed39bb2db875106fa6274622a3256efef6a48f1c1f55525305"
          },
          "mechanism": "Type 1 diabetes is autoimmune-mediated, typically requiring insulin from diagnosis. Type 1 status is a determinant of insulin requirements and determines current disease severity. Type 1 diabetes affects metabolic status and long-term health, which relates to cirrhosis risk.",
          "justification": "Confounds the exposure-outcome relationship through disease severity and metabolic status.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.5",
            "quoted_wording": "sha256:d937c9a5e0752b7d4dca9e10a5da07320f475c90f87509f9651ee7784ee965cc"
          },
          "mechanism": "Age at Type 1 diabetes diagnosis reflects disease duration and long-term metabolic exposure, a marker of disease severity.",
          "justification": "Confounds the exposure-outcome relationship through disease severity and metabolic status.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.6",
            "quoted_wording": "sha256:55600e24b14333ff4c2cea0d744d84df721ba906ace8329551ba8072ef427427"
          },
          "mechanism": "Type 2 diabetes prevalence is higher than Type 1. Insulin use in Type 2 indicates poor glycemic control and advanced disease. Type 2 is associated with metabolic syndrome and fat redistribution, which affect both insulin requirement and liver health including fatty liver disease.",
          "justification": "Confounds through metabolic syndrome and disease severity markers.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.7",
            "quoted_wording": "sha256:feb48f11c86453b98ad0851786a09c58f9d1e8e132724ccd7d6ea779c5a96e39"
          },
          "mechanism": "Age at Type 2 diabetes diagnosis reflects disease duration and metabolic dysfunction time-course, a marker of disease severity.",
          "justification": "Confounds through metabolic syndrome and disease severity markers.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q9.8",
            "quoted_wording": "sha256:75280df2ed2c4c3e0d15aa33e12b34dc78154bcfe0cb34cc8a4eef4e64c7ece4"
          },
          "mechanism": "Gestational diabetes is a marker of underlying metabolic dysfunction and insulin resistance. It predicts later Type 2 diabetes. Persons with gestational diabetes have altered metabolic status relevant to both insulin dosing and fatty liver disease.",
          "justification": "Proxies for metabolic dysfunction affecting both exposure and outcome.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.43",
            "quoted_wording": "sha256:9933e522f2d47ade5ac83961618bf35b7b41479b62a4e27c194bbfc9ad392c23"
          },
          "mechanism": "Hepatitis B is a direct cause of cirrhosis. Age at hepatitis B diagnosis is a marker of hepatitis serostatus and infection history. Hepatitis B acquisition may correlate with health access or risk behaviors that also affect diabetes management and medication adherence.",
          "justification": "Confounds if hepatitis acquisition is related to health behaviors or access that affect insulin management; directly causes outcome.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.44",
            "quoted_wording": "sha256:5cd67afb874bd0cd0aad3e9cdb75428e3db234f074ae018ed909992e4505a6c0"
          },
          "mechanism": "Hepatitis C is a direct cause of cirrhosis. Age at hepatitis C diagnosis marks serostatus. Like hepatitis B, acquisition may correlate with health behaviors.",
          "justification": "Confounds if hepatitis acquisition is related to health behaviors or access that affect insulin management; directly causes outcome.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m3:Q15.7",
            "quoted_wording": "sha256:ed5b18e3585428555a7a752d8719073435ee873307bc6fa8ce6a726ccceb866f"
          },
          "mechanism": "Alcohol is a major direct cause of cirrhosis. Heavy alcohol use may correlate with poor health behaviors and poor diabetes management, creating potential confounding.",
          "justification": "Confounds if health-behavior patterns affect both insulin adherence and drinking patterns.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.10",
