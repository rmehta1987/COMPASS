          },
          "mechanism": "Race and ethnicity affect diabetes incidence, health care access, health behaviors, and liver disease risk through social determinants, genetic variation, and behavioral patterns.",
          "justification": "Confounds through multiple pathways affecting both exposure and outcome.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.3",
            "quoted_wording": "sha256:1502a55645513419f8997fa1a3261928116635487d10c83882c7b7ce91cc61fa"
          },
          "mechanism": "Sex affects insulin dosing (weight-adjusted), diabetes prevalence, alcohol metabolism, and liver disease susceptibility.",
          "justification": "Biological and social determinant of both exposure and outcome.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
