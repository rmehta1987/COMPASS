      "dictionary_version": "3dc8415eccfe",
      "question": "Does regular use of Celebrex (celecoxib) cause or predict earlier age at onset of esophageal acid reflux?",
      "exposure": {
        "kind": "variable",
        "key": "m2:Q19.57",
        "quoted_wording": "sha256:56cb4b2f5edb222411c780c9fca2b3d77118104f16f1ec4a3fcc2393069ea434"
      },
      "outcome": {
        "kind": "variable",
        "key": "m2:Q5.37",
        "quoted_wording": "sha256:ea4e177aa01219b26ec395f58208901c904e8ed76b756c3a0f758f44148466d1"
      },
      "expected_direction": {
        "direction": "decrease",
        "magnitude": null,
        "magnitude_source": null
      },
      "falsifier": "The study falsifies the null hypothesis of no effect if the risk difference in reflux diagnosis prevalence between regular Celebrex users and non-users is at least 5.11 percentage points at a sample size near 3000 participants.",
      "falsifier_threshold": {
        "value": 5.11,
        "unit": "percentage points",
        "comparator": ">="
      },
      "model_spec": {
        "form": "Linear regression of age at reflux diagnosis on Celebrex exposure status, adjusted for covariates; or logistic regression of reflux prevalence (ever diagnosed yes/no) on Celebrex exposure status, adjusted for covariates.",
        "unit_of_analysis": "participant",
        "clustering": "Cluster-robust standard errors at the community area level (COMPASS cohort design)."
      },
      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.3",
            "quoted_wording": "sha256:1502a55645513419f8997fa1a3261928116635487d10c83882c7b7ce91cc61fa"
          },
          "mechanism": "Sex is a confounder. GERD prevalence, severity, and symptom experience differ between males and females. NSAID use patterns and indications also vary by sex, with differences in musculoskeletal pain prevalence and arthritis diagnoses between sexes.",
          "justification": "Common cause of both exposure (NSAID use) and outcome (reflux diagnosis).",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m3:Q5.5",
            "quoted_wording": "sha256:de9dcac5ebc6d726296a67ec78524bb13c5da9982763c0234ce9ca8653cc6c0a"
          },
          "mechanism": "Smoking relaxes the lower esophageal sphincter, delays gastric emptying, and damages the esophageal mucosa, all increasing reflux risk. Smoking is also associated with chronic musculoskeletal pain and arthritis, conditions that lead to regular NSAID use for pain management.",
          "justification": "Common cause of both exposure and outcome.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q2.10",
            "quoted_wording": "sha256:b188718a8d8144f5fe4cf3c35a60b74088dcd97a8cf89ca2f1fec01a9af8139b"
          },
          "mechanism": "Higher body weight increases intra-abdominal pressure and reduces lower esophageal sphincter tone, directly increasing reflux risk. Weight is also associated with arthritis and other musculoskeletal conditions that are key indications for Celebrex use.",
          "justification": "Common cause of both exposure and outcome.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q2.9#1_1",
            "quoted_wording": "sha256:e30a159d94d34e7a3b602c00d1f86c21376380e38318aad6cf08cc81403a6845"
          },
          "mechanism": "Height is a component of BMI. Body mass index is an established independent risk factor for GERD.",
          "justification": "Precision variable; proxy for BMI-based confounder control.",
          "role": "proxy",
          "proxy_for": "body mass index",
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.15#1_43",
            "quoted_wording": "sha256:6a7fb39cb83783cbd71e63aa7541f80383df047570713b581da82f7588023941"
          },
          "mechanism": "Rheumatoid arthritis is a primary clinical indication for Celebrex use. Patients with RA require NSAID therapy for pain and inflammation management. RA does not directly cause reflux biologically, but RA patients may have different lifestyle, weight distribution, and medication profiles that influence reflux risk.",
          "justification": "Cause of the exposure; adjusting for it isolates the NSAID effect in a comparable group.",
          "role": "cause_of_exposure_only",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q21.5",
            "quoted_wording": "sha256:1f37f7feab32cf2f1807ed6be294b21e149fe2aa59afc88658951fa54e0d366f"
          },
          "mechanism": "Proton pump inhibitors are medications used to treat reflux disease. PPI use is a direct therapeutic response to reflux diagnosis, making it a consequence or mediator in the causal pathway. Including it would block the pathway from Celebrex use to reflux and artificially attenuate the estimated effect.",
          "justification": "Descendant of outcome or mediator in the causal pathway.",
          "role": "descendant_of_outcome",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m3:Q15.7",
            "quoted_wording": "sha256:ec4fdf58d3e2253c2c77a03507408d4bd73dad0ab475da70b422c3a76b48073d"
          },
          "mechanism": "Alcohol consumption directly reduces lower esophageal sphincter tone and irritates the esophageal mucosa, increasing reflux risk. However, alcohol use is not causally related to Celebrex use—patients do not take Celebrex because of alcohol consumption. Alcohol is not a common cause of both exposure and outcome.",
          "justification": "Causes outcome but not exposure; not a confounder.",
          "role": "not_a_cause_of_either",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "undetermined_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q19.28",
            "quoted_wording": "sha256:d8459274d2310d358ff7ce00966922cac3bb26c070b4118d925c7662faa14f8d"
          },
          "mechanism": "Ibuprofen is a conventional NSAID used for similar musculoskeletal pain indications as Celebrex. Ibuprofen use could represent either: (a) an underlying chronic pain condition or arthritis that predisposes to NSAID use generally (confounder), or (b) alternative or concurrent NSAID therapy that is part of the causal pathway or parallel exposure. The role cannot be clearly determined without additional information about whether these NSAIDs are used for overlapping conditions or distinct conditions.",
          "justification": "Could act as confounder (marker of pain/arthritis) or mediator (alternative NSAID therapy).",
          "role": "confounder_or_mediator",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "sought_covariates": [
        {
          "construct_sought": "Participant age at baseline",
          "search_phrases": [
