    "protocol": {
      "protocol_id": "m2q8.7_to_m2q5.38",
      "dictionary_version": "3dc8415eccfe",
      "question": "Does a mother's history of breastfeeding her children relate to the age at which she is diagnosed with gout?",
      "exposure": {
        "kind": "variable",
        "key": "m2:1_Q8.7",
        "quoted_wording": "sha256:d0e33cd5bd9e132b52cddb9e4f162f1d85a216b06e637b82f319a28036efb7d0"
      },
      "outcome": {
        "kind": "variable",
        "key": "m2:Q5.38",
        "quoted_wording": "sha256:7dce2dd02d1a8822a5034773e675c4a6feff8626ac6de67db59ad87ae5271be3"
      },
      "expected_direction": {
        "direction": "no_difference",
        "magnitude": null,
        "magnitude_source": null
      },
      "falsifier": "If breastfeeding history has a true causal effect on age at gout diagnosis, the magnitude of that effect (estimated as a difference in mean age at diagnosis between those who breastfed and those who did not) should be at least 5.11 percentage points in absolute terms.",
      "falsifier_threshold": {
        "value": 5.11,
        "unit": "percentage points",
        "comparator": ">="
      },
      "model_spec": {
        "form": "Linear regression of age at gout diagnosis on breastfeeding status (yes/no), adjusted for sex at birth, birth year, weight, alcohol consumption, and income. Alternatively, Cox proportional hazards model if framed as time-to-gout-diagnosis with censoring.",
        "unit_of_analysis": "participant",
        "clustering": "Cluster-robust standard errors at the community area level (COMPASS design convention; Chicago Multiethnic Prevention and Surveillance Study is geographically stratified by community area)"
      },
      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.3",
            "quoted_wording": "sha256:1502a55645513419f8997fa1a3261928116635487d10c83882c7b7ce91cc61fa"
          },
          "mechanism": "Sex at birth is a cause of the exposure (only females can breastfeed) and a cause of the outcome (males have higher gout prevalence).",
          "justification": "Without adjustment, any sex imbalance in the sample would bias the exposure-outcome association.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q2.15_3",
            "quoted_wording": "sha256:ad7c805a862e7b7a8108d049792b0ac9c0565ecf18fb6bd6180854a61aed5e2c"
          },
          "mechanism": "Birth year determines the participant's current age, which structures the observation window for gout diagnosis (older age increases opportunity for gout onset, and it affects when the participant was having children and breastfeeding). Age is a strong confounder of gout risk.",
          "justification": "Age is universally a strong confounder in gout studies. Without adjustment, age-related differences in gout prevalence and incidence would be confounded with exposure.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q2.10",
            "quoted_wording": "sha256:b188718a8d8144f5fe4cf3c35a60b74088dcd97a8cf89ca2f1fec01a9af8139b"
          },
          "mechanism": "Obesity (measured by weight, or more precisely BMI if height is included) is a well-established risk factor for gout. Weight may also relate to the breastfeeding decision (mothers with higher weight may have been less likely to breastfeed, or conversely weight gain may follow poor health behaviors that also include not breastfeeding). Weight confounds the relationship.",
          "justification": "Obesity is causal for gout; adjustment reduces residual confounding from metabolic status.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m3:Q15.7",
            "quoted_wording": "sha256:ec4fdf58d3e2253c2c77a03507408d4bd73dad0ab475da70b422c3a76b48073d"
          },
          "mechanism": "Alcohol consumption is a well-established risk factor for gout, particularly beer consumption in men. Alcohol consumption patterns may also reflect lifestyle and health behaviors that could associate with breastfeeding decisions. This is a confounder.",
          "justification": "Alcohol is causal for gout; adjustment removes this source of confounding.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q5.4",
            "quoted_wording": "sha256:13d3548965635d4117cbd0b28b41f20541d0d0827da994eef2ca27064ff58d60"
          },
          "mechanism": "Socioeconomic status (measured by income) affects both the exposure and the outcome. SES determines access to healthcare (and thus opportunity to be diagnosed with gout), diet quality and patterns (associated with gout risk), and historically has complex associations with breastfeeding (currently higher SES mothers are more likely to breastfeed, but this relationship has reversed over time). SES confounds both directions.",
          "justification": "SES is a source of confounding; adjustment improves causal inference.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.6",
            "quoted_wording": "sha256:883085f9e05c1ff52e186d0ca76208723c1d81024663315e7f20b7cc5c94c2d4"
          },
          "mechanism": "Type 2 Diabetes is a metabolic disease that could lie on the pathway between breastfeeding history (as a marker of maternal health behaviors and early-life circumstances) and gout (both metabolic outcomes). If breastfeeding marks maternal health consciousness or nutritional status, this may influence the child's metabolic programming or the mother's later metabolic health, which then increases gout risk via diabetes and related metabolic dysfunction.",
          "justification": "Including a mediator in the model would attenuate the exposure-outcome association, obscuring the full effect of breastfeeding history (interpreted broadly as health behavior marker) on gout timing. Exclusion preserves the total effect.",
          "role": "mediator",
          "proxy_for": null,
          "contestable": false
        }
      ],
