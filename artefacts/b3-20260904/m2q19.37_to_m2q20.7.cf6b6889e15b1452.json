      "dictionary_version": "3dc8415eccfe",
      "question": "Does the frequency of regular acetaminophen use (days per month during periods of regular use) relate to how long ago an individual regularly took statins?",
      "exposure": {
        "kind": "variable",
        "key": "m2:Q19.37",
        "quoted_wording": "sha256:3ce9e4f24f9162e25272a153b6b46ea747135370a028dac6b3f929e598f35334"
      },
      "outcome": {
        "kind": "variable",
        "key": "m2:Q20.7",
        "quoted_wording": "sha256:ef2d30ba104abbad7145dff4bb9974f1b08d3f98e514e41394c20b3090e25132"
      },
      "expected_direction": {
        "direction": "no_difference",
        "magnitude": null,
        "magnitude_source": null
      },
      "falsifier": "Acetaminophen use frequency (days per month during regular use) is statistically significantly associated with the timing (years ago) of regular statin use, adjusting for age, sex at birth, hypertension diagnosis, and diabetes status (Type 1 or Type 2).",
      "falsifier_threshold": null,
      "model_spec": {
        "form": "Linear regression with statin use timing (years ago, continuous outcome) regressed on acetaminophen frequency (days per month, continuous exposure) with adjustment for five covariates.",
        "unit_of_analysis": "participant",
        "clustering": "cluster-robust standard errors at the community area level"
      },
      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q2.15_3",
            "quoted_wording": "sha256:ad7c805a862e7b7a8108d049792b0ac9c0565ecf18fb6bd6180854a61aed5e2c"
          },
          "mechanism": "Age is the primary confounder. Older participants have longer medical histories, making them more likely to have taken statins in the distant past. Age also correlates with chronic pain conditions (arthritis, degenerative joint disease) that drive acetaminophen use.",
          "justification": "Age confounds because it affects both the exposure (medication use patterns across the lifespan) and the outcome (opportunity for healthcare encounters where statins might have been prescribed).",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q1.8",
            "quoted_wording": "sha256:dd506fb26782a15e8b85ef427d7c49a15e1f410cad8f95d65022706f7d14555f"
          },
          "mechanism": "Sex at birth relates to the prevalence of cardiovascular disease and pain conditions. Males have higher early coronary artery disease risk, affecting statin prescribing patterns. Sex also varies in pain condition prevalence and pain medication use behaviors.",
          "justification": "Confounds through sex-dependent cardiovascular risk profiles and pain-related medication engagement.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.8",
            "quoted_wording": "sha256:5522bc79a69cdb0f9bcf39abca278fe5e82c1e226c81b522a7fd9afdd097716f"
          },
          "mechanism": "Hypertension is a major cardiovascular risk factor and a direct trigger for statin prescribing in clinical practice. People diagnosed with hypertension are substantially more likely to have cardiovascular screening and statin initiation. Hypertension also reflects overall disease burden and medication use patterns.",
          "justification": "Hypertension is a causal risk factor for statin prescribing and must be adjusted to isolate the effect of acetaminophen frequency from the confounding due to cardiovascular disease risk.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.6",
            "quoted_wording": "sha256:883085f9e05c1ff52e186d0ca76208723c1d81024663315e7f20b7cc5c94c2d4"
          },
          "mechanism": "Type 2 diabetes substantially increases cardiovascular disease risk. People with Type 2 diabetes are routinely evaluated for cardiovascular disease and prescribed statins for primary prevention, even without prior cardiac events.",
          "justification": "Confounder through cardiovascular disease risk stratification protocols in clinical practice.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.4",
            "quoted_wording": "sha256:0dc03e0aff41272217dd560ef65d0f5e95dbef85e9a956bfc84997bdad4ea035"
          },
          "mechanism": "Type 1 diabetes is also associated with elevated cardiovascular risk and statin prescribing recommendations.",
          "justification": "Confounder for statin use through CVD risk assessment.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q19.13",
            "quoted_wording": "sha256:189878b056a59f67b223ec14512433cdcaa9967cf6fdf7b88e316b540e367b68"
          },
          "mechanism": "Regular aspirin use is an alternative pain medication choice. It does not lie in the causal pathway between acetaminophen frequency and statin use timing. Aspirin use does not determine statin prescribing decisions, nor is it determined by acetaminophen frequency.",
          "justification": "While both aspirin and acetaminophen are pain medications, aspirin use is independent of the acetaminophen-to-statin relationship. Including it would add complexity without addressing confounding.",
          "role": "not_a_cause_of_either",
          "proxy_for": null,
          "contestable": false
        }
      ],
