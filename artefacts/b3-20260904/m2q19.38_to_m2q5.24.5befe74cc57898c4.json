      "dictionary_version": "3dc8415eccfe",
      "question": "Does higher acetaminophen use increase the likelihood of bipolar disorder diagnosis, or lead to earlier age at bipolar disorder diagnosis?",
      "exposure": {
        "kind": "variable",
        "key": "m2:Q19.38",
        "quoted_wording": "sha256:8dea5c3fb0aaaeb2302369f9e1f5d649d708fe399f35a8eaa6cfef91ebf0f9af"
      },
      "outcome": {
        "kind": "variable",
        "key": "m2:Q5.24",
        "quoted_wording": "sha256:cf363bbf919b73b4dfde6e7a64f82b8cd7a03ee3fcf4e86bc68d18228a3efa45"
      },
      "expected_direction": {
        "direction": "increase",
        "magnitude": null,
        "magnitude_source": null
      },
      "falsifier": "The association between acetaminophen use and bipolar disorder diagnosis, adjusted for confounding by sex, race, ethnicity, chronic pain, and prior psychiatric illness, should be detectable at a magnitude of at least a risk difference of 8.86 percentage points in diagnosis prevalence between high and low use groups (evaluated at n=1000). Alternatively, if the outcome is specified as continuous age at diagnosis, the falsifier is stated in prose: a clinically meaningful difference in age at bipolar disorder diagnosis between high and low acetaminophen use groups, accounting for the community-area clustering design effect which increases the true smallest detectable effect beyond the values shown.",
      "falsifier_threshold": {
        "value": 8.86,
        "unit": "percentage points",
        "comparator": ">="
      },
      "model_spec": {
        "form": "Linear or logistic regression of bipolar disorder diagnosis age (or diagnosis status) on acetaminophen pill count (continuous or categorized), adjusted for sex, race, ethnicity, chronic pain, and prior psychiatric illness",
        "unit_of_analysis": "participant",
        "clustering": "Cluster-robust standard errors at community area level"
      },
      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.3",
            "quoted_wording": "sha256:1502a55645513419f8997fa1a3261928116635487d10c83882c7b7ce91cc61fa"
          },
          "mechanism": "Sex relates to chronic pain prevalence, symptom presentation and diagnostic thresholds in bipolar disorder, and healthcare-seeking patterns.",
          "justification": "Sex is a demographic confounder that could produce spurious association through differential pain-driven medication use and differential psychiatric symptom recognition.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.10",
            "quoted_wording": "sha256:780728bf35035558d044eb83b0a0913fa9ac23432800ba7771332210ddb7cedd"
          },
          "mechanism": "Race relates to healthcare access, pain medication prescribing patterns, and psychiatric diagnosis rates due to structural inequities and diagnostic practice variations.",
          "justification": "Race-based disparities in healthcare access and psychiatric diagnosis could confound the association between reported medication use and diagnosis recognition.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.8",
            "quoted_wording": "sha256:a10a496fc05ed9ee27e352d585b73564c6380fa93220d96d5bb1bf12b34e95e6"
          },
          "mechanism": "Hispanic/Latino ethnicity relates to healthcare system engagement and psychiatric diagnosis patterns independent of pain and medication use.",
          "justification": "Ethnic disparities in healthcare access and diagnostic practices could create confounding.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q19.85",
            "quoted_wording": "sha256:0bae0955b5020c35263bc3d183ab8e57593e361613b3dbeeab021acf02e2f47d"
          },
          "mechanism": "Chronic pain directly causes acetaminophen use AND independently drives increased healthcare contact; greater healthcare engagement increases opportunity for psychiatric diagnosis detection.",
          "justification": "This is a direct confounder—underlying pain independently increases both exposure (acetaminophen use for pain management) and healthcare contact that leads to bipolar diagnosis recognition.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.30",
            "quoted_wording": "sha256:1b3efc7594d0cc4d06035229a893f6e98f899e0e4a4c97c79830a2e86d15b990"
          },
          "mechanism": "Prior depression diagnosis is a marker of underlying psychiatric vulnerability and mood disorder predisposition that predisposes to somatic and stress-related symptoms driving pain medication use and health-seeking behavior.",
          "justification": "Prior psychiatric illness creates spurious association between acetaminophen (proxy for stress-related symptoms and healthcare engagement) and bipolar diagnosis through underlying psychopathology.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.18",
            "quoted_wording": "sha256:9b99356b9e919aeea0d6bf9fcc84627f9f8cb7128bf188cd97c33abc5ded3191"
          },
          "mechanism": "Prior anxiety diagnosis indicates psychiatric vulnerability; anxiety disorders are associated with pain complaints and somatic symptoms that drive OTC pain medication use.",
          "justification": "Like depression, prior anxiety indicates underlying mental illness predisposing to both pain-related medication use and psychiatric diagnosis engagement.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q4.1",
            "quoted_wording": "sha256:d98074b2bd279bfa6f182d2c4c1959d48bace261f3281424dea972b10dbdc1ee"
          },
          "mechanism": "Measures current and recent healthcare needs unrelated to historical bipolar diagnosis or exposure period.",
          "justification": "Temporal relationship is too ambiguous—the question window (past 12 months) does not align with outcome (historical diagnosis age) or exposure (time of regular use, unspecified). Not causally related to either.",
          "role": "not_a_cause_of_either",
          "proxy_for": null,
