      "model_spec": {
        "form": "Linear regression or ordinal logistic regression of age at bronchitis diagnosis on exposure (recency of NSAID use), with adjustment for confounders",
        "unit_of_analysis": "participant",
        "clustering": "Community area level with cluster-robust standard errors"
      },
      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q1.8",
            "quoted_wording": "sha256:dd506fb26782a15e8b85ef427d7c49a15e1f410cad8f95d65022706f7d14555f"
          },
          "mechanism": "Sex-based differences in NSAID use (women may preferentially use NSAIDs for menstrual pain, while men use them for arthritis/sports injuries), and sex-based differences in bronchitis prevalence and diagnosis rates due to smoking patterns and occupational exposures.",
          "justification": "Sex is a cause of both exposure (differential NSAID use) and outcome (differential bronchitis diagnosis).",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m3:Q5.3",
            "quoted_wording": "sha256:3482b2afcf1f7edfe24aea6d63f797620fa160a888531cbbefe30a795f4ae67d"
          },
          "mechanism": "Smoking is a primary cause of chronic bronchitis; smokers are also more likely to use NSAIDs for smoking-related pain and inflammation. Smoking status affects both the likelihood of being diagnosed with bronchitis and patterns of pain management medication use.",
          "justification": "Smoking creates a common cause pathway to both exposure (NSAID use for smoking-related symptoms) and outcome (bronchitis diagnosis).",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.2",
            "quoted_wording": "sha256:e672fe3877afaccf4fdb8494eb3a52b9b49409338fc5e962bf41e697ec74fbfb"
          },
          "mechanism": "Asthma and chronic bronchitis are related respiratory conditions affecting symptom burden. People with asthma may use NSAIDs for inflammation management (though with caution due to NSAID-asthma interactions), and asthma diagnosis associates with bronchitis diagnosis through shared respiratory pathology and increased medical surveillance.",
          "justification": "Asthma relates to both NSAID use patterns (pain/inflammation management) and bronchitis diagnosis risk (related respiratory disease).",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.11",
            "quoted_wording": "sha256:45f00b152c1b85953fc15fb60065f1ca1ffffc566a72d7902ecca4f602786ef1"
          },
          "mechanism": "Education affects health literacy, healthcare-seeking behavior, and access to information about both medication use and disease symptoms. More educated individuals may be more likely to seek diagnosis for chronic conditions and may have different pain management preferences.",
          "justification": "Education is a cause of healthcare engagement and diagnosis likelihood, and independently relates to medication use choices.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q5.4",
            "quoted_wording": "sha256:79590ca38c808b483369e51527ceca6aca100f2472a404c51b46d36b4411c743"
          },
          "mechanism": "Income affects access to healthcare (likelihood of diagnosis), access to medications (prescription NSAIDs vs. OTC vs. unaffordable), and overall health status. Lower-income individuals may have lower rates of clinical diagnosis while potentially higher rates of unmanaged disease.",
          "justification": "Income is a cause of both healthcare access/diagnosis and medication purchasing and use patterns.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m3:Q15.7",
            "quoted_wording": "sha256:ed5b18e3585428555a7a752d8719073435ee873307bc6fa8ce6a726ccceb866f"
          },
          "mechanism": "Alcohol use relates to NSAID use for pain management (hangovers, alcohol-related pain); alcohol consumption also affects respiratory and general health status. Alcohol users may differ in healthcare engagement.",
          "justification": "Alcohol use associates with both medication use patterns and general health status including respiratory health.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.6",
            "quoted_wording": "sha256:55600e24b14333ff4c2cea0d744d84df721ba906ace8329551ba8072ef427427"
          },
          "mechanism": "Diabetes patients use NSAIDs for pain management (diabetic neuropathy, arthritis). However, diabetes is not a direct cause of the age at which someone is first told they have chronic bronchitis; while diabetes affects general inflammation and immune function, its pathway to bronchitis diagnosis age is indirect and not clearly causal.",
          "justification": "Diabetes does not causally affect the outcome (age at bronchitis diagnosis) and therefore does not open a confounding pathway. While it may associate with NSAID use, this does not represent confounding of the exposure-outcome relationship.",
          "role": "not_a_cause_of_either",
          "proxy_for": null,
          "contestable": false
        }
      ],
