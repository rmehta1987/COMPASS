      },
      "expected_direction": {
        "direction": "increase",
        "magnitude": null,
        "magnitude_source": null
      },
      "falsifier": "A positive association between pregnancy history and antihypertensive medication intensity of ≥8.86 percentage points (comparing highest versus lowest pregnancy counts) at n=1,000 would be detectable and inconsistent with the null hypothesis of no effect. This threshold assumes two-sided α=0.05, power=0.80, independent observations, and dichotomization of the outcome at its median.",
      "falsifier_threshold": {
        "value": 8.86,
        "unit": "percentage points",
        "comparator": ">="
      },
      "model_spec": {
        "form": "Linear regression of pills per day (continuous outcome) on number of pregnancies (continuous exposure), adjusted for six confounders: Hispanic/Latino ethnicity, race, household income, Type 1 Diabetes status, Type 2 Diabetes status, and chronic kidney disease age-at-diagnosis",
        "unit_of_analysis": "participant",
        "clustering": "By community area, with cluster-robust standard errors"
      },
