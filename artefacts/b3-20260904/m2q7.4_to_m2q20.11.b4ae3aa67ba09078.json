          },
          "mechanism": "Race confounds the exposure-outcome relationship through differential parity distributions and differential hypertension prevalence and care patterns across racial groups.",
          "justification": "Standard demographic confounder in hypertension research.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
