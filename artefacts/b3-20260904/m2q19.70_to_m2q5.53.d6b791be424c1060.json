      "question": "Is the frequency of regular prescription opioid use associated with the age at which individuals are first diagnosed with migraine?",
      "exposure": {
        "kind": "variable",
        "key": "m2:Q19.70",
        "quoted_wording": "sha256:b553b6ef27cde6b5f599eecab2f753e7a9bff12d1c3729831514f9148c527e68"
      },
      "outcome": {
        "kind": "variable",
        "key": "m2:Q5.53",
