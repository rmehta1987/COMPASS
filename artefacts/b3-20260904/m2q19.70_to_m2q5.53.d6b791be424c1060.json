      },
      "expected_direction": {
        "direction": "non_monotonic",
        "magnitude": null,
        "magnitude_source": null
      },
      "falsifier": "Among participants, higher opioid use frequency (operationalized as highest versus lowest quartile of days per month) is associated with a difference of at least 10 percentage points in the risk of migraine diagnosis (comparing those with opioid exposure in the highest quartile to the lowest quartile).",
      "falsifier_threshold": {
        "value": 10.0,
        "unit": "percentage points",
        "comparator": ">="
      },
      "model_spec": {
        "form": "Linear regression (if outcome is continuous age at diagnosis) or logistic regression (if dichotomized as migraine diagnosed before vs. after a threshold age, or ever vs. never diagnosed among the eligible sample); regression coefficient or odds ratio estimated for opioid use frequency (continuous days per month or categorical contrast high vs. low), adjusted for all variables in the adjusted covariate list.",
        "unit_of_analysis": "participant",
        "clustering": "Cluster-robust standard errors at the community area level. The number of participants per community area and the intracluster correlation for these variables are unknown; therefore the design effect cannot be computed and clustering effects are unaccounted for."
      },
      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.3",
            "quoted_wording": "sha256:1502a55645513419f8997fa1a3261928116635487d10c83882c7b7ce91cc61fa"
          },
          "mechanism": "Sex at birth affects both opioid prescribing patterns (sex differences in pain management) and migraine prevalence and diagnosis timing (migraine is more common in females and may be diagnosed differently across sexes).",
          "justification": "Demographic confounder; independently associated with healthcare access patterns and provider behavior.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.10",
            "quoted_wording": "sha256:780728bf35035558d044eb83b0a0913fa9ac23432800ba7771332210ddb7cedd"
          },
          "mechanism": "Race/ethnicity influences opioid prescribing rates (documented disparities in pain treatment) and migraine diagnosis rates (disparities in healthcare access and diagnostic labeling).",
          "justification": "Demographic confounder reflecting both prescribing bias and differential diagnostic recognition.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.11",
            "quoted_wording": "sha256:45f00b152c1b85953fc15fb60065f1ca1ffffc566a72d7902ecca4f602786ef1"
          },
          "mechanism": "Education correlates with health literacy, healthcare-seeking behavior, provider relationships, and ability to access and navigate pain management. It also associates with understanding and reporting of symptoms.",
          "justification": "Socioeconomic proxy and marker of healthcare engagement; independently affects both opioid access and migraine diagnosis.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q5.4",
            "quoted_wording": "sha256:79590ca38c808b483369e51527ceca6aca100f2472a404c51b46d36b4411c743"
          },
          "mechanism": "Income determines access to healthcare, choice of providers, ability to seek specialty care for pain or migraine, and quality of care received.",
          "justification": "Socioeconomic confounder; directly affects both opioid access and migraine diagnosis pathways.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q2.2",
            "quoted_wording": "sha256:e83a2c35edfd30f2ea3f17c0b6baf7cdf5f2a7d34ed56f0fa0780a6749a21bba"
          },
          "mechanism": "Insurance status determines access to prescription medications (including opioids), specialist referrals, and diagnostic services. It shapes provider behavior in prescribing and diagnosis.",
          "justification": "Healthcare access confounder; insurance influences both treatment availability and diagnostic recognition.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q19.85",
            "quoted_wording": "sha256:9f220ae5bf1a06aec78fca284826844b246c62a5266437e8861dc11d1a3aaf07"
          },
          "mechanism": "This measures current/recent pain experience, which is a consequence of both chronic opioid use (indicating ongoing pain management) and migraine diagnosis (which is painful). It is not an independent cause of either the historical exposure (opioid use frequency during a defined past period) or the historical outcome (age at diagnosis).",
          "justification": "Current pain status is a descendant of the underlying disease/treatment trajectory. Including it would induce collider bias by conditioning on an outcome of the exposure-outcome system.",
          "role": "descendant_of_outcome",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "undetermined_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.52",
            "quoted_wording": "sha256:c9b6aaa957073613f497cc293861ebc84d5306d342d07952ced5529665b68688"
          },
          "mechanism": "Age at depression diagnosis could represent a pre-existing condition that independently causes both opioid use (via pain syndromes comorbid with depression) and affects migraine diagnosis timing (psychiatric comorbidity changes healthcare engagement). Alternatively, opioid use could cause depression as a side effect or consequence of addiction, making depression a mediator rather than confounder. Or depression could be a correlated outcome of similar healthcare dynamics.",
          "justification": "The temporal relationship between depression onset and opioid use is unknown; cannot determine whether depression is a cause of both (confounder), a consequence of exposure (mediator), or a separate manifestation of shared underlying factors.",
          "role": "confounder_or_mediator",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.18",
            "quoted_wording": "sha256:9b99356b9e919aeea0d6bf9fcc84627f9f8cb7128bf188cd97c33abc5ded3191"
          },
          "mechanism": "Like depression, age at anxiety diagnosis could indicate pre-existing psychological conditions that cause both opioid use and affect healthcare-seeking for migraine, OR it could represent anxiety induced by chronic opioid use or pain, OR it could reflect shared underlying psychopathology.",
          "justification": "Temporal precedence is unknown; cannot assign causal role without determining whether anxiety predates or follows opioid use initiation.",
          "role": "confounder_or_mediator",
          "proxy_for": null,
          "contestable": false
        }
      ],
