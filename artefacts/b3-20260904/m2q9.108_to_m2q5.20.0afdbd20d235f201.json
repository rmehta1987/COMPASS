      "question": "Does surgical removal of one or both ovaries associate with the age at which arthritis is first diagnosed?",
      "exposure": {
        "kind": "variable",
        "key": "m2:Q9.108",
        "quoted_wording": "sha256:4e5c3f3c1366eda11237b4a1b8b23836b6b0a6041c47f9adebe1c2797c9d9009"
      },
      "outcome": {
        "kind": "variable",
        "key": "m2:Q5.20",
        "quoted_wording": "sha256:cab2a4842a03d48ce8b63052a7db8b628e3ed6033b26ff3ac11bcded10178dd7"
      },
      "expected_direction": {
        "direction": "increase",
        "magnitude": null,
        "magnitude_source": null
      },
      "falsifier": "Oophorectomy is associated with a difference in the prevalence of arthritis diagnosed before age 50, such that the magnitude of the risk difference is large enough to be detectable at the study's sample size.",
      "falsifier_threshold": {
        "value": 9.0,
        "unit": "percentage points",
        "comparator": ">="
      },
      "model_spec": {
        "form": "Logistic regression with oophorectomy (binary) as the primary predictor of dichotomized arthritis onset age (before age 50 vs. age 50+), adjusted for six covariates.",
        "unit_of_analysis": "participant",
        "clustering": "Cluster-robust standard errors (Huber-White sandwich estimator) with clustering at the community area level."
      },
      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q2.15_3",
            "quoted_wording": "sha256:ad7c805a862e7b7a8108d049792b0ac9c0565ecf18fb6bd6180854a61aed5e2c"
          },
          "mechanism": "Age is a fundamental confounder. Older women have higher baseline arthritis risk due to cumulative exposure and aging of the immune system. Oophorectomy rates were higher in older birth cohorts due to historical gynecological practices, creating confounding by birth year.",
          "justification": "Age must be controlled to isolate the association between oophorectomy and arthritis age at onset.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.10",
            "quoted_wording": "sha256:780728bf35035558d044eb83b0a0913fa9ac23432800ba7771332210ddb7cedd"
          },
          "mechanism": "Race/ethnicity affects both arthritis incidence and access to gynecological procedures. Some racial groups have higher prevalence of rheumatoid arthritis.",
          "justification": "Failing to adjust for race/ethnicity could yield biased estimates if oophorectomy rates differ by race or if race affects arthritis diagnosis patterns.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q2.10",
            "quoted_wording": "sha256:b188718a8d8144f5fe4cf3c35a60b74088dcd97a8cf89ca2f1fec01a9af8139b"
          },
          "mechanism": "Obesity is a major risk factor for osteoarthritis and increases systemic inflammation, potentially increasing rheumatoid arthritis risk. Weight may also relate to clinical decisions to undergo oophorectomy.",
          "justification": "Weight is an independent predictor of arthritis and may confound if oophorectomy decisions are related to general health status or BMI.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m3:Q5.5",
            "quoted_wording": "sha256:de9dcac5ebc6d726296a67ec78524bb13c5da9982763c0234ce9ca8653cc6c0a"
          },
          "mechanism": "Smoking is a well-established risk factor for rheumatoid arthritis, particularly seropositive disease. Smoking is also associated with healthcare utilization and preventive health behaviors that might influence oophorectomy decisions.",
          "justification": "Smoking status is an independent risk factor for the outcome and may relate to the exposure through overall health-seeking behavior.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.11",
            "quoted_wording": "sha256:45f00b152c1b85953fc15fb60065f1ca1ffffc566a72d7902ecca4f602786ef1"
          },
          "mechanism": "Education serves as a proxy for socioeconomic status, which affects access to gynecological surgery and to diagnosis/treatment of arthritis. Higher education may be associated with earlier healthcare-seeking and diagnosis.",
          "justification": "SES confounds both the exposure (access to elective gynecological procedures) and the outcome (access to arthritis diagnosis and healthcare).",
          "role": "proxy",
          "proxy_for": "socioeconomic status",
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q9.104",
            "quoted_wording": "sha256:e770648a9d0b1b81410fba79beaa830081a58ae6bcab245a1745d353222efe71"
          },
          "mechanism": "Hysterectomy is often performed concurrently with or related to oophorectomy. Hysterectomy may independently affect immune function or arthritis risk through mechanisms separate from estrogen loss. Hysterectomy status is a marker of gynecological intervention patterns.",
          "justification": "Hysterectomy status could confound if it is independently associated with both oophorectomy likelihood and arthritis risk.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q9.46",
            "quoted_wording": "sha256:f575372c75ef1974346cb87d655ec922eb401bd91357d58114e1e5ecca83b73f"
          },
          "mechanism": "Hormone replacement therapy (HRT) use is causally downstream of oophorectomy. Women who undergo oophorectomy frequently receive HRT to offset the loss of endogenous estrogen. The protective effect of estrogen on arthritis risk is hypothesized to operate through HRT use when administered post-operatively.",
          "justification": "HRT use is a mediator of the total causal effect of oophorectomy on arthritis risk. Including it would estimate the direct effect rather than the total effect. The total effect is appropriate for the causal question of interest.",
          "role": "mediator",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "undetermined_covariates": [],
      "sought_covariates": [
