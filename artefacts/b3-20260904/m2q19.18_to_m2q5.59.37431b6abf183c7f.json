      "question": "Does a history of regular aspirin use associate with the age at which individuals are first diagnosed with shingles (herpes zoster)?",
      "exposure": {
        "kind": "variable",
        "key": "m2:Q19.18",
        "quoted_wording": "sha256:a9a64a74d1cab5da782c0acf8a8a15cb8ad0d08a36da5af327f7d6b2f91bc8f7"
      },
      "outcome": {
        "kind": "variable",
