      },
      "expected_direction": {
        "direction": "no_difference",
        "magnitude": null,
        "magnitude_source": null
      },
      "falsifier": "A statistically significant association between regular aspirin use history and age at shingles diagnosis in the hypothesized direction (aspirin use history associated with older age at diagnosis), detectable at the smallest detectable effect threshold for the analytic sample size.",
      "falsifier_threshold": {
        "value": 8.86,
        "unit": "percentage points",
        "comparator": ">="
      },
      "model_spec": {
        "form": "Linear regression with age at shingles diagnosis (continuous, in years) as the outcome. The exposure is binary (regular aspirin use history: yes/no). All nine adjusted covariates are included. Standard errors estimated using cluster-robust covariance estimation.",
        "unit_of_analysis": "participant",
        "clustering": "Community area"
      },
      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.3",
            "quoted_wording": "sha256:1502a55645513419f8997fa1a3261928116635487d10c83882c7b7ce91cc61fa"
          },
          "mechanism": "Sex confounds because patterns of aspirin use differ by sex (cardiovascular disease prevalence), and shingles incidence and age of diagnosis vary by sex.",
          "justification": "Operates as a confounder.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.10",
            "quoted_wording": "sha256:780728bf35035558d044eb83b0a0913fa9ac23432800ba7771332210ddb7cedd"
          },
          "mechanism": "Race/ethnicity affects prevalence of cardiovascular disease and other chronic conditions driving aspirin use, and also affects immunocompromise risk and potentially shingles epidemiology.",
          "justification": "Operates as a confounder.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q2.15_3",
            "quoted_wording": "sha256:ad7c805a862e7b7a8108d049792b0ac9c0565ecf18fb6bd6180854a61aed5e2c"
          },
          "mechanism": "Birth year determines current age and birth cohort. Older individuals take more aspirin and have had more opportunity for shingles diagnosis. Birth cohort effects influence both exposure likelihood and outcome timing.",
          "justification": "Birth cohort is the primary confounder; without age adjustment, the entire association is confounded by age.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.6",
            "quoted_wording": "sha256:883085f9e05c1ff52e186d0ca76208723c1d81024663315e7f20b7cc5c94c2d4"
          },
          "mechanism": "Type 2 Diabetes increases cardiovascular risk (driving aspirin use) and impairs cell-mediated immunity (increasing shingles risk).",
          "justification": "Confounds the exposure-outcome association.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.8",
            "quoted_wording": "sha256:5522bc79a69cdb0f9bcf39abca278fe5e82c1e226c81b522a7fd9afdd097716f"
          },
          "mechanism": "Hypertension is a leading indication for aspirin use and may be associated with vascular changes affecting immune function.",
          "justification": "Confounds exposure-outcome association.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.45",
            "quoted_wording": "sha256:4fd4b5e8c6da5523798a1aaca864daa72a9067b7b0f63445ca0f3ed7ae8874b4"
          },
          "mechanism": "HIV/AIDS is a strong risk factor for varicella-zoster virus reactivation and shingles. HIV status may also correlate with medication use patterns.",
          "justification": "Strong confounder of the outcome.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.29",
            "quoted_wording": "sha256:8f7a250aae8614d933f3f746e3bda5faa34a21b8ce5e39d693311dbca6b57abc"
          },
          "mechanism": "Chronic kidney disease is associated with cardiovascular risk (driving aspirin indication) and with immune dysfunction (affecting shingles risk).",
          "justification": "Confounds both pathways through cardiovascular and immune dysfunction mechanisms.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.32",
            "quoted_wording": "sha256:27d4ee29ea7b33f51e9adf9423afcb48482787d3e94cc8a6d1459635ba34c64a"
          },
          "mechanism": "Coronary artery disease is a primary clinical indication for regular aspirin use and indicates higher cardiovascular risk burden.",
          "justification": "Direct confounding of exposure; coronary disease may also influence immune status.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.35",
            "quoted_wording": "sha256:0388f9e220566f60386f1fa01e1a8bc4b5cef4742f3f8072dc88783baa8d9c74"
          },
          "mechanism": "COPD involves systemic inflammation and immune dysfunction affecting shingles risk; may also influence medication use patterns.",
          "justification": "Associated with both exposure and outcome.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
