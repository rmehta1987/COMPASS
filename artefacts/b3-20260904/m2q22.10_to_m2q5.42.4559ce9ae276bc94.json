      "dictionary_version": "3dc8415eccfe",
      "question": "Does regular over-the-counter antihistamine use associate with earlier diagnosis of heart valve problems?",
      "exposure": {
        "kind": "variable",
        "key": "m2:Q22.10",
        "quoted_wording": "sha256:4cb07dc3b6b46cc70d313c1a12a48af818eb7e92e1137ea206d0d40664b54bd1"
      },
      "outcome": {
        "kind": "variable",
        "key": "m2:Q5.42",
        "quoted_wording": "sha256:c907cdc050458359f8763d8241f72993b217795055f0adf6e5489a718754f223"
      },
      "expected_direction": {
        "direction": "decrease",
        "magnitude": null,
        "magnitude_source": null
      },
      "falsifier": "Antihistamine use is associated with a clinically and epidemiologically meaningful earlier diagnosis of heart valve problems: participants in the highest quintile of antihistamine use frequency will receive their diagnosis of heart valve problems at an age that is meaningfully younger than those in the lowest quintile, after adjustment for cardiovascular risk factors and allergic disease severity indicators.",
      "falsifier_threshold": null,
      "model_spec": {
        "form": "Linear regression with continuous age at heart valve diagnosis as the outcome. The model will regress age at diagnosis on the dichotomous indicator of exposure quintile (highest vs. lowest) with adjustment for the seven covariates listed above.",
        "unit_of_analysis": "participant",
        "clustering": "cluster-robust at the community area level"
      },
      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q1.8",
            "quoted_wording": "sha256:dd506fb26782a15e8b85ef427d7c49a15e1f410cad8f95d65022706f7d14555f"
          },
          "mechanism": "Sex at birth is a common cause of both exposure and outcome. Biological sex differences drive allergic disease prevalence (hence antihistamine use) and independently influence baseline cardiovascular disease risk, clinical presentation, and age of diagnosis.",
          "justification": "Sex is foundational to both allergy epidemiology and cardiac disease epidemiology; without adjustment, sex-specific disease burdens would confound the exposure-outcome association.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.8",
            "quoted_wording": "sha256:54859c0b47368445f04b396a67b96ed6934dcd16cef08c3db16e3357147c596b"
          },
          "mechanism": "Hypertension is a direct cause of cardiac disease progression and valve involvement. It may also share lifestyle and metabolic antecedents with both antihistamine use patterns and cardiovascular vulnerability.",
          "justification": "Hypertension is among the strongest modifiable risk factors for heart valve pathology and earlier clinical recognition of cardiac disease; controlling for it prevents confounding through cardiac disease severity.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.4",
            "quoted_wording": "sha256:06f26b3aeabb79ed39bb2db875106fa6274622a3256efef6a48f1c1f55525305"
          },
          "mechanism": "Type 1 diabetes independently increases the risk of cardiac disease and may be associated with antihistamine use through shared inflammatory or immune pathways.",
          "justification": "Diabetes is a strong driver of both microvascular and macrovascular cardiac disease; controlling for it prevents confounding by diabetes-associated cardiac risk.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.6",
            "quoted_wording": "sha256:55600e24b14333ff4c2cea0d744d84df721ba906ace8329551ba8072ef427427"
          },
          "mechanism": "Type 2 diabetes is a major cause of cardiac disease, including valve disease and cardiomyopathy, and may share common metabolic or lifestyle antecedents with antihistamine use frequency.",
          "justification": "Type 2 diabetes is highly prevalent and a potent risk factor for valve disease and earlier cardiac diagnosis in many populations.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.14",
            "quoted_wording": "sha256:f0b0976512c4170b51cf92eb8fad551bfbbe1c4e806a0ef7132e5c1151b2e74b"
          },
          "mechanism": "High cholesterol is a direct cause of atherosclerotic and valve disease progression and is also associated with lifestyle patterns that might relate to medication use.",
          "justification": "Hypercholesterolemia accelerates valve calcification and cardiomyopathy; controlling for cholesterol status prevents confounding by lipid-driven disease severity.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.2",
            "quoted_wording": "sha256:e672fe3877afaccf4fdb8494eb3a52b9b49409338fc5e962bf41e697ec74fbfb"
          },
          "mechanism": "Asthma diagnosis is a marker of atopic/allergic disease predisposition, which directly causes antihistamine use (exposure) and may associate with inflammatory or immune factors that also affect cardiac disease risk.",
          "justification": "Asthma serves as a proxy for underlying allergic disease burden; participants with asthma will use antihistamines more frequently, and the asthma-related inflammatory phenotype may independently relate to cardiac outcomes.",
          "role": "proxy",
          "proxy_for": "allergic disease predisposition",
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q11.5",
            "quoted_wording": "sha256:1988764166598130cb66e276c44712faf10b6f297c4d0f6486ef35e219b600cb"
          },
          "mechanism": "History of allergic reactions indicates current allergic disease severity and symptom burden, which directly drives the need for antihistamine use (exposure). Allergic disease severity may also indicate inflammatory or immune dysfunction relevant to cardiac disease pathogenesis.",
          "justification": "Controlling for allergy attack history isolates exposure variation that is not merely a marker of allergic disease presence (already captured by asthma) but reflects active disease burden and symptom frequency, the direct trigger for antihistamine use.",
          "role": "proxy",
          "proxy_for": "allergy severity",
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q11.7",
            "quoted_wording": "sha256:708775dac317495bfca89717fde6881b6014e0447e3c3fa900419f161e8a88b4"
          },
          "mechanism": "This variable is too proximal to the exposure. Over-the-counter antihistamine use is a form of allergy treatment, and this question asks about treatment broadly. Adjusting for 'any allergy treatment ever' would remove exposure variation that specifically distinguishes antihistamine use frequency, obscuring the exposure-outcome association the design aims to measure.",
          "justification": "Including this variable would conflate the specific effect of antihistamine medication with the general effect of receiving any allergy treatment.",
          "role": "descendant_of_exposure",
          "proxy_for": null,
          "contestable": false
        }
      ],
