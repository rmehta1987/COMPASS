      "question": "Does regular celecoxib (Celebrex/NSAIDs) use affect lifetime marijuana vaping behavior among adults?",
      "exposure": {
        "kind": "variable",
        "key": "m2:Q19.58",
        "quoted_wording": "sha256:2c7cc302c4c63a96802a9f08141b022e12fc0e142b616f4a031916ab498a6414"
      },
      "outcome": {
        "kind": "variable",
        "key": "m3:Q13.1",
        "quoted_wording": "sha256:506dbb501d9d68e9ae7d699005de93968b5300a76b77cad3427c4ab39d196988"
      },
      "expected_direction": {
        "direction": "no_difference",
        "magnitude": null,
        "magnitude_source": null
      },
      "falsifier": "The null hypothesis is no association between celecoxib use frequency and lifetime marijuana vaping days. A falsifiable alternative is that regular celecoxib use is associated with differences in lifetime vaping days. The direction of effect is not specified a priori.",
      "falsifier_threshold": {
        "value": 8.86,
        "unit": "percentage points",
        "comparator": ">="
      },
      "model_spec": {
        "form": "Linear regression with continuous outcome (lifetime days of marijuana vaping) or logistic regression if outcome is dichotomized (any vaping vs. none)",
        "unit_of_analysis": "participant",
        "clustering": "community area (COMPASS design includes community-area clustering; cluster-robust standard errors required)"
      },
      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.3",
            "quoted_wording": "sha256:1502a55645513419f8997fa1a3261928116635487d10c83882c7b7ce91cc61fa"
          },
          "mechanism": "Sex/biological sex influences the prevalence of chronic pain conditions (e.g., women have higher rates of arthritis, fibromyalgia) and influences prescribing patterns (differential NSAID vs. opioid prescribing by sex). Sex also influences substance use patterns and social norms around drug use.",
          "justification": "Sex is a demographic confounder affecting both exposure likelihood (pain condition prevalence, prescribing access) and outcome likelihood (substance use patterns).",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.8",
            "quoted_wording": "sha256:a10a496fc05ed9ee27e352d585b73564c6380fa93220d96d5bb1bf12b34e95e6"
          },
          "mechanism": "Race/ethnicity is associated with differential healthcare access, prescribing patterns (e.g., differential NSAID and opioid prescribing by race/ethnicity), prevalence of chronic pain conditions, and substance use norms. These factors influence both celecoxib use and marijuana vaping independently.",
          "justification": "Ethnicity is a demographic confounder reflecting broader structural and social differences in healthcare and substance use.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.10",
            "quoted_wording": "sha256:780728bf35035558d044eb83b0a0913fa9ac23432800ba7771332210ddb7cedd"
          },
          "mechanism": "Race is associated with differential pain condition prevalence, healthcare access, provider prescribing patterns, and substance use patterns.",
          "justification": "Race is a demographic confounder reflecting structural inequities in healthcare and health outcomes.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.15#1_5",
            "quoted_wording": "sha256:a603bbc099d69e6c3cfedc0a68e1f198a8aebaf370f7b33083ad3525d3aa04ce"
          },
          "mechanism": "Arthritis is a direct clinical indication for celecoxib use (strong cause of exposure). Arthritis also causes chronic pain, which may motivate self-medication with cannabis (potential cause of outcome). Both pathways exist independently: arthritis → celecoxib, and arthritis → cannabis use for pain management.",
          "justification": "Arthritis is a common indication for NSAID use and a condition that might drive cannabis self-medication; it must be controlled to avoid bias from the shared etiology.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m3:Q2.1",
            "quoted_wording": "sha256:8bf19c5680503fcf9b7b276de9082b99380a66febb459021f7d497181bb4f1ae"
          },
          "mechanism": "Self-rated health is associated with actual disease burden and functional limitations. People with worse health are more likely to use prescription pain medications including celecoxib. People with worse health (or greater functional impairment) might also be more likely to self-medicate with cannabis.",
          "justification": "Overall health status is a confounder affecting both celecoxib use (indication for pain relief) and marijuana vaping (motivation for symptom management).",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m3:Q15.2",
            "quoted_wording": "sha256:3d6739b193ceaa886e1cdb2d124dc9773635a38ec720b02ef57aac8b3a72879d"
          },
          "mechanism": "Lifetime history of any alcohol use is a proxy indicator for substance use propensity or willingness to use psychoactive/pharmacological agents. Individuals with higher substance use propensity may be more likely to both use prescribed medications (celecoxib) when available and to try self-administered substances (cannabis).",
          "justification": "Substance use propensity is an unmeasured confounder; lifetime alcohol use serves as a proxy for this underlying predisposition.",
          "role": "proxy",
          "proxy_for": "Substance use propensity or willingness to use pharmacological agents",
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m3:Q11.1",
            "quoted_wording": "sha256:e4eea771dd6ce9bee1f2f87085ead63dbed95af42dd4d45cdf4ff4377b384df6"
          },
          "mechanism": "This variable measures lifetime cannabis use history in a specific form (smoking). It reflects underlying cannabis use propensity. Someone with a lifetime history of marijuana smoking is more likely to also have tried or use vaping as an alternative form of cannabis administration.",
          "justification": "Lifetime cannabis use propensity confounds the relationship between celecoxib use and marijuana vaping. Individuals with higher cannabis use propensity are more likely to vape, and this propensity is independent of celecoxib use.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.1",
            "quoted_wording": "sha256:cb90ebab960b02949b903b578a6d1a6bd147f5bcbf3dc520def38e0d71bcfbb1"
          },
          "mechanism": "Geographic origin (country of birth or origin) does not itself directly cause celecoxib use or marijuana vaping. Geographic origin is captured more specifically by the race/ethnicity variables already adjusted.",
          "justification": "Country of origin does not create a distinct confounding pathway beyond ethnicity/race; inclusion would reduce precision without reducing bias.",
          "role": "not_a_cause_of_either",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
