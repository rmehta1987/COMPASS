            "quoted_wording": "sha256:16d7eea5541bf8da230e2fb4e326b08f86bc108ca54590dbe34a047428ed7bea"
          },
          "mechanism": "While marital status might correlate with substance use patterns, the causal mechanism is not clear. Marital status does not directly cause celecoxib prescribing, nor is there a direct mechanism by which marital status causes marijuana vaping. Any association is likely mediated by confounders already controlled.",
          "justification": "Marital status is not a direct cause of either variable; exclusion improves precision.",
          "role": "not_a_cause_of_either",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.4",
            "quoted_wording": "sha256:6d466dcc5981bd3ba56449e7e907aaaff7c3dc666df8fdb33233a8c1c258156c"
          },
          "mechanism": "Gender identity is distinct from sex at birth and may influence substance use norms and healthcare provider interactions; however, with sex at birth already adjusted, any independent causal pathways are unclear and not distinctly identified.",
          "justification": "The independent confounding contribution of gender identity cannot be determined from available evidence. With sex at birth (m1:Q3.3) already adjusted, excluding this variable improves precision while likely capturing the primary demographic confounding pathways.",
          "role": "not_a_cause_of_either",
          "proxy_for": null,
          "contestable": false
        }
