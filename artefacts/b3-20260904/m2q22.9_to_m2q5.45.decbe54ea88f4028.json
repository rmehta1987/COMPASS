            "quoted_wording": "sha256:dd506fb26782a15e8b85ef427d7c49a15e1f410cad8f95d65022706f7d14555f"
          },
          "mechanism": "Sex at birth is fundamental to HIV epidemiology, affecting both infection risk through sexual behavior patterns and healthcare-seeking behaviors and diagnosis patterns.",
          "justification": "Sex at birth causally determines both the exposure (healthcare engagement patterns affecting medication use) and the outcome (HIV infection and diagnosis timing).",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.10",
            "quoted_wording": "sha256:780728bf35035558d044eb83b0a0913fa9ac23432800ba7771332210ddb7cedd"
          },
          "mechanism": "Racial and ethnic differences in HIV epidemiology, healthcare access, healthcare quality, and health behaviors are well-documented, affecting both likelihood of HIV infection and diagnosis timing and patterns of healthcare engagement including OTC medication use.",
          "justification": "COMPASS is designed as a multiethnic study and racial and ethnic differences in both antihistamine use patterns and HIV diagnosis must be accounted for.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.6",
            "quoted_wording": "sha256:86013eba768e1467e021e99635e08310e49f1e3195c1546c965b21116f52f664"
          },
          "mechanism": "Sexual orientation shapes sexual behavior patterns, which is the strongest determinant of HIV infection risk in most populations, and also affects healthcare-seeking behaviors and community engagement with health information.",
          "justification": "Sexual orientation is a critical confounder likely masking a spurious or marginal association between antihistamine use and diagnosis age, and must be controlled for.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q2.2",
            "quoted_wording": "sha256:e83a2c35edfd30f2ea3f17c0b6baf7cdf5f2a7d34ed56f0fa0780a6749a21bba"
          },
          "mechanism": "Insurance status is a direct determinant of both regular healthcare contact enabling HIV diagnosis and access to medications including OTC antihistamines, with uninsured or poorly insured individuals having both lower rates of HIV testing and lower rates of regular medication use.",
          "justification": "Insurance is a confounding cause of both exposure and outcome and must be adjusted for.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q5.4",
            "quoted_wording": "sha256:13d3548965635d4117cbd0b28b41f20541d0d0827da994eef2ca27064ff58d60"
          },
          "mechanism": "Socioeconomic status affects healthcare access, health behaviors, and ability to purchase OTC medications, with lower income associated with both lower likelihood of regular medical care and delayed HIV diagnosis.",
          "justification": "Income directly causes both the exposure and outcome and must be adjusted for.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.11",
            "quoted_wording": "sha256:45f00b152c1b85953fc15fb60065f1ca1ffffc566a72d7902ecca4f602786ef1"
          },
          "mechanism": "Education affects health literacy, awareness of HIV transmission and testing, healthcare-seeking behavior, and awareness of when to seek diagnosis, and may also correlate with access to antihistamines and health information.",
          "justification": "While education may partly operate through healthcare access already captured by insurance, it captures independent variation in health knowledge and behavior that reduces outcome variance.",
          "role": "precision",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q11.5",
            "quoted_wording": "sha256:1988764166598130cb66e276c44712faf10b6f297c4d0f6486ef35e219b600cb"
          },
          "mechanism": "Allergic conditions are the primary indication for antihistamine use, making this a strong predictor of the exposure; allergic disease may also affect immune function and healthcare-engagement patterns influencing HIV diagnosis timing.",
          "justification": "This variable captures the degree to which antihistamine use is driven by actual allergic disease, acting as a confounder by the indication for treatment.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        }
      ],
