      "protocol_id": "m2q9.105_to_m2q5.19",
      "dictionary_version": "3dc8415eccfe",
      "question": "Does hysterectomy increase the risk of arrhythmia diagnosis, and if so, does the timing of hysterectomy matter?",
      "exposure": {
        "kind": "variable",
        "key": "m2:Q9.105",
        "quoted_wording": "sha256:d8fa2cbb5d4c385d89326144804bf3d09b914322d998c3dcab05c76ef1538160"
      },
      "outcome": {
        "kind": "variable",
        "key": "m2:Q5.19",
        "quoted_wording": "sha256:ba3f2573cf180c03f92a7f5a8a9f653760bafe9747a47f6022d86d07c0f37f4b"
      },
      "expected_direction": {
        "direction": "increase",
        "magnitude": "approximately 3-fold to 5-fold increase in arrhythmia risk per 15-year younger age at hysterectomy",
        "magnitude_source": "hormonal or physiological mechanisms of hysterectomy effects on cardiac rhythm"
      },
      "falsifier": "The null hypothesis is that age at hysterectomy is not associated with arrhythmia (either no relationship in the regression coefficient, or an odds ratio of 1.0 in logistic regression). The alternative hypothesis is a directional relationship: earlier hysterectomy is associated with higher arrhythmia risk or earlier diagnosis.",
      "falsifier_threshold": {
        "value": 10.0,
        "unit": "percentage points",
        "comparator": ">="
      },
      "model_spec": {
        "form": "Regression of age at arrhythmia diagnosis (m2:Q5.19) on age at hysterectomy (m2:Q9.105), adjusted for hypertension, diabetes, race, and weight. If outcome is continuous: ordinary least squares regression with robust standard errors. If outcome is binary: logistic regression with odds ratio reported.",
        "unit_of_analysis": "participant",
        "clustering": "Cluster-robust standard errors at the community area level"
      },
      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.8",
            "quoted_wording": "sha256:54859c0b47368445f04b396a67b96ed6934dcd16cef08c3db16e3357147c596b"
          },
          "mechanism": "Hypertension is an independent cardiovascular risk factor that predicts arrhythmia incidence and diagnosis.",
          "justification": "Hypertension is a confounder because it is associated with both the probability of hysterectomy and the probability of arrhythmia diagnosis independent of hysterectomy.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.6",
            "quoted_wording": "sha256:55600e24b14333ff4c2cea0d744d84df721ba906ace8329551ba8072ef427427"
          },
          "mechanism": "Type 2 diabetes is a major cardiovascular and metabolic risk factor, independently and substantially associated with increased arrhythmia risk.",
          "justification": "Diabetes confounds the exposure-outcome relationship because it independently increases arrhythmia risk and may be associated with selection into or timing of hysterectomy.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.10",
            "quoted_wording": "sha256:780728bf35035558d044eb83b0a0913fa9ac23432800ba7771332210ddb7cedd"
          },
          "mechanism": "Race/ethnicity is a demographic marker associated with both cardiovascular disease risk and hysterectomy rates.",
          "justification": "Race/ethnicity confounds because it is associated with the exposure distribution and predicts the outcome.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q2.10",
            "quoted_wording": "sha256:b188718a8d8144f5fe4cf3c35a60b74088dcd97a8cf89ca2f1fec01a9af8139b"
          },
          "mechanism": "Weight/BMI is a known cardiovascular risk factor that is independently associated with arrhythmia and may be associated with indications for hysterectomy.",
          "justification": "Weight confounds the relationship because it predicts arrhythmia risk and may be associated with the exposure.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.61",
            "quoted_wording": "sha256:b82f826fbe176b50bfb23894466b23ecfe4403cfea676d696c31e8a43e808747"
          },
          "mechanism": "Stroke is a known thromboembolic complication of arrhythmia, particularly atrial fibrillation, and represents a causal consequence of arrhythmia via blood stasis and clot formation.",
          "justification": "Stroke is a descendant of the outcome (arrhythmia). Including stroke in the model would condition on a causal consequence of the outcome, potentially creating collider bias and biasing the exposure-outcome estimate.",
          "role": "descendant_of_outcome",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.25",
            "quoted_wording": "sha256:70dbdfb2e8d8921c85fbc215cb02393396b90f0db57c2f4b729a5f3e60791125"
          },
          "mechanism": "Blood clots/DVT can result from arrhythmia-related thromboembolism and are therefore a potential consequence of the outcome; alternatively, blood clots could be a complication of hysterectomy surgery itself.",
          "justification": "Blood clots are a descendant of the outcome and/or the exposure. Including them would create collider bias or mediator-blocking, obscuring the direct relationship between hysterectomy and arrhythmia.",
          "role": "descendant_of_outcome",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "undetermined_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q9.46",
            "quoted_wording": "sha256:f575372c75ef1974346cb87d655ec922eb401bd91357d58114e1e5ecca83b73f"
          },
          "mechanism": "Hormone therapy use is downstream of menopausal status and reproductive health conditions and could be causally related to both hysterectomy (women who undergo hysterectomy may initiate or continue HT for menopausal symptoms) and arrhythmia (HT is a known cardiovascular risk factor).",
          "justification": "The temporal and causal relationship between hormone therapy, hysterectomy, and arrhythmia cannot be fully resolved without additional information on timing and indication. Depending on whether HT is a mediator or confounder, it should either be excluded or adjusted.",
          "role": "confounder_or_mediator",
          "proxy_for": null,
          "contestable": false
        }
      ],
