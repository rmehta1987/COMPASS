      "dictionary_version": "3dc8415eccfe",
      "question": "Does regular over-the-counter melatonin use influence the likelihood of using antihypertensive medication regularly?",
      "exposure": {
        "kind": "variable",
        "key": "m2:Q22.15",
        "quoted_wording": "sha256:4e100b4a9f72e7c393db50b95b09a5914dd341f548dd3a6c1525fed16027b4b6"
      },
      "outcome": {
        "kind": "variable",
        "key": "m2:Q20.8",
        "quoted_wording": "sha256:1fb5af950eb4cdd1fe89fc76a98a1f4300582e231673f0026dd99465d8a3b0cb"
      },
      "expected_direction": {
        "direction": "non_monotonic",
        "magnitude": null,
        "magnitude_source": null
      },
      "falsifier": "A meaningful biological or behavioral difference in antihypertensive medication use between regular melatonin users and non-users. We operationalize this as a minimum detectable risk difference.",
      "falsifier_threshold": {
        "value": 6.0,
        "unit": "percentage points",
        "comparator": ">="
      },
      "model_spec": {
        "form": "Logistic regression predicting binary outcome (ever regular antihypertensive medication use: yes/no) from binary exposure (ever regular melatonin use: yes/no), adjusted for the covariate set listed above. The model will take the form: logit(P(HTN meds)) = β₀ + β_melatonin · Melatonin + Σ βᵢ · Covariateᵢ",
        "unit_of_analysis": "participant",
        "clustering": "Community area clustering. Participants are nested within Chicago community areas. Standard errors must be cluster-robust, computed at the community area level."
      },
      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.3",
            "quoted_wording": "sha256:1502a55645513419f8997fa1a3261928116635487d10c83882c7b7ce91cc61fa"
          },
          "mechanism": "Sex is associated with both sleep patterns/disorders and hypertension prevalence. Sex differences in circadian physiology, hormone metabolism, and healthcare-seeking behavior create pathways from sex to both melatonin use and antihypertensive medication use.",
          "justification": "Documented sex differences in sleep quality, insomnia prevalence, and hypertension prevalence in midlife and older adults; men and women differ in medication-seeking behavior and supplement use.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.10",
            "quoted_wording": "sha256:780728bf35035558d044eb83b0a0913fa9ac23432800ba7771332210ddb7cedd"
          },
          "mechanism": "Race is associated with hypertension prevalence, healthcare access, medication use patterns, and sleep quality. Structural and biological factors related to race affect both exposure and outcome independently.",
          "justification": "Well-documented racial disparities in hypertension prevalence and control; racial differences in sleep disorders and supplement use; racial differences in healthcare access and medication patterns.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.8",
            "quoted_wording": "sha256:a10a496fc05ed9ee27e352d585b73564c6380fa93220d96d5bb1bf12b34e95e6"
          },
          "mechanism": "Hispanic/Latino ethnicity is associated with hypertension prevalence and medication access; may relate to sleep quality and supplement use through cultural, healthcare access, and socioeconomic pathways.",
          "justification": "Ethnic differences in cardiovascular risk profiles and medication patterns; Hispanic/Latino populations show specific hypertension prevalence patterns.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m3:Q3.21",
            "quoted_wording": "sha256:6396df41900b04ec3da8f8ddef54fc13f5fe8c913623a7f9bd6a5d572152e211"
          },
          "mechanism": "Poor sleep quality is an upstream common cause of both melatonin use (people with poor sleep proactively use melatonin to improve sleep) and antihypertensive medication use (poor sleep increases hypertension risk and cardiovascular burden independently of other pathways). Sleep quality affects both behavioral choices (supplement use) and physiologic outcomes (HTN risk).",
          "justification": "Sleep quality is bidirectionally associated with hypertension; poor sleep is strongly associated with supplement and melatonin use; sleep quality is an independent risk factor for hypertension independent of diagnosed sleep disorders.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m3:Q3.28",
            "quoted_wording": "sha256:c99d8c3145f2c330020fbaa79c75298bd194e7e21b10240e87e9837fa8669a40"
          },
          "mechanism": "Diagnosed or clinically significant sleep problems directly prompt melatonin use as a first-line intervention and are associated with elevated hypertension through circadian disruption, sympathetic activation, and repeated blood pressure surges during arousals.",
          "justification": "Sleep disorders (insomnia, obstructive sleep apnea, restless leg syndrome) are strongly associated with hypertension and HTN medication use; diagnosis of sleep problems directly drives melatonin use; sleep disorders are bidirectionally related to hypertension risk.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.8",
            "quoted_wording": "sha256:54859c0b47368445f04b396a67b96ed6934dcd16cef08c3db16e3357147c596b"
          },
          "mechanism": "Hypertension diagnosis indicates underlying HTN condition/status. HTN causes sleep complications and fragmentation (prompting melatonin use through poor sleep quality pathway) and directly necessitates antihypertensive medication. HTN diagnosis creates a confounding path: HTN → sleep disruption → melatonin use, and HTN → medication use.",
          "justification": "Hypertension is known to cause sleep fragmentation and poor sleep quality; HTN is the direct indication for antihypertensive medication; HTN affects both sides of the exposure-outcome pair through sleep mechanisms and direct medication indication.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.6",
            "quoted_wording": "sha256:55600e24b14333ff4c2cea0d744d84df721ba906ace8329551ba8072ef427427"
          },
          "mechanism": "Type 2 diabetes is associated with both hypertension prevalence (T2DM is a major risk factor for HTN) and sleep quality issues (neuropathy, nocturia, sleep apnea comorbidity). Diabetic patients are more likely to use multiple medications and may have different health-seeking and supplement-use behaviors.",
          "justification": "T2DM is strongly associated with hypertension prevalence and HTN medication use; T2DM is associated with sleep disorders and poor sleep quality; diabetic patients typically use more medications overall.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m3:Q15.2",
            "quoted_wording": "sha256:3d6739b193ceaa886e1cdb2d124dc9773635a38ec720b02ef57aac8b3a72879d"
          },
          "mechanism": "Alcohol use disrupts sleep architecture and is associated with hypertension. Alcohol use affects sleep quality (prompting melatonin use) and is independently associated with elevated hypertension risk and medication use.",
          "justification": "Alcohol is a known sleep disruptor and is associated with hypertension; alcohol use patterns affect both sleep quality and cardiovascular risk independently.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m3:Q5.5",
            "quoted_wording": "sha256:de9dcac5ebc6d726296a67ec78524bb13c5da9982763c0234ce9ca8653cc6c0a"
          },
          "mechanism": "Smoking disrupts sleep quality and is an independent risk factor for hypertension. Smoking affects both melatonin use (through sleep disruption) and antihypertensive medication use (through direct HTN risk).",
          "justification": "Smoking is associated with sleep fragmentation and poor sleep quality; smoking is an independent risk factor for hypertension; smoking is associated with medication use patterns and healthcare engagement.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.32",
            "quoted_wording": "sha256:27d4ee29ea7b33f51e9adf9423afcb48482787d3e94cc8a6d1459635ba34c64a"
          },
          "mechanism": "Coronary artery disease is a consequence of chronic hypertension and hypertensive end-organ damage. It is downstream of the outcome (antihypertensive medication targets the hypertension condition; prolonged uncontrolled hypertension leads to coronary disease).",
          "justification": "Coronary disease results from chronic hypertensive injury to the coronary vasculature; it is a collateral outcome of hypertension, not a confounder of the exposure-outcome relationship.",
          "role": "descendant_of_outcome",
          "proxy_for": null,
          "contestable": false
        }
      ],
