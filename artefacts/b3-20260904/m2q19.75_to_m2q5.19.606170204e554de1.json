          },
          "mechanism": "Coronary artery disease can cause arrhythmia through ischemia; represents part of the same acute coronary syndrome/cardiovascular disease process as arrhythmia.",
          "justification": "Excluded to avoid adjusting for descendants of the outcome.",
          "role": "descendant_of_outcome",
          "proxy_for": null,
