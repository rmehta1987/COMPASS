      },
      "expected_direction": {
        "direction": "increase",
        "magnitude": null,
        "magnitude_source": null
      },
      "falsifier": "The association between regular opioid use and arrhythmia diagnosis is not clinically or statistically meaningful if the absolute risk difference is less than 5.11 percentage points",
      "falsifier_threshold": {
        "value": 5.11,
        "unit": "percentage points",
        "comparator": "<"
      },
      "model_spec": {
        "form": "Logistic regression predicting arrhythmia diagnosis (yes/no), or linear regression of age at diagnosis among those diagnosed, with opioid use as primary exposure and seven adjusted covariates",
        "unit_of_analysis": "participant",
        "clustering": "Cluster-robust standard errors at the community area level; design effect unknown"
      },
      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q1.8",
            "quoted_wording": "sha256:dd506fb26782a15e8b85ef427d7c49a15e1f410cad8f95d65022706f7d14555f"
          },
          "mechanism": "Sex classification affects both patterns of opioid prescribing and utilization, and independently predicts cardiovascular disease risk and arrhythmia prevalence.",
          "justification": "Males and females have documented differences in opioid prescription rates and cardiovascular risk profiles; sex is a confounder of the exposure-outcome relationship.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.8",
            "quoted_wording": "sha256:5522bc79a69cdb0f9bcf39abca278fe5e82c1e226c81b522a7fd9afdd097716f"
          },
          "mechanism": "Hypertension is a major cardiovascular risk factor strongly associated with arrhythmia development. Hypertension status also reflects general health burden and medication burden, which may correlate with opioid use patterns.",
          "justification": "Hypertension confounds the opioid-arrhythmia association by independently increasing arrhythmia risk; controlling for it isolates the opioid effect from baseline cardiovascular disease burden.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.4",
            "quoted_wording": "sha256:0dc03e0aff41272217dd560ef65d0f5e95dbef85e9a956bfc84997bdad4ea035"
          },
          "mechanism": "Type 1 diabetes is a metabolic disorder associated with increased cardiovascular disease risk and arrhythmia; it may also correlate with pain conditions or healthcare-seeking behavior affecting opioid exposure.",
          "justification": "Diabetes is a major cardiovascular risk factor; adjusting for it removes confounding by metabolic disease status.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.6",
            "quoted_wording": "sha256:883085f9e05c1ff52e186d0ca76208723c1d81024663315e7f20b7cc5c94c2d4"
          },
          "mechanism": "Type 2 diabetes is strongly associated with cardiovascular disease and arrhythmia risk; also often co-occurs with chronic pain conditions that lead to opioid use.",
          "justification": "Controls for confounding by metabolic disease and chronic disease burden.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.20",
            "quoted_wording": "sha256:cab2a4842a03d48ce8b63052a7db8b628e3ed6033b26ff3ac11bcded10178dd7"
          },
          "mechanism": "Arthritis is a chronic pain condition that is a primary driver of regular opioid use. While arthritis does not directly cause arrhythmia, age at arthritis diagnosis reflects pain burden and healthcare engagement, which correlates with opioid exposure.",
          "justification": "Arthritis is strongly predictive of opioid exposure; controlling for it reduces residual confounding and improves precision of the opioid-arrhythmia estimate.",
          "role": "precision",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.18",
            "quoted_wording": "sha256:9b99356b9e919aeea0d6bf9fcc84627f9f8cb7128bf188cd97c33abc5ded3191"
          },
          "mechanism": "Anxiety disorders are associated with chronic pain and thus opioid use; independently, anxiety disorders are associated with increased arrhythmia risk through both physiological (sympathetic activation) and behavioral pathways.",
          "justification": "Anxiety disorder confounds the exposure-outcome relationship via two pathways: anxiety → pain → opioids AND anxiety → arrhythmia risk independently.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.30",
            "quoted_wording": "sha256:1b3efc7594d0cc4d06035229a893f6e98f899e0e4a4c97c79830a2e86d15b990"
          },
          "mechanism": "Depression is associated with chronic pain severity and opioid use; also independently associated with cardiovascular disease and arrhythmia risk.",
          "justification": "Depression confounds by affecting both exposure and outcome.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.41",
            "quoted_wording": "sha256:d3785560fd2f6612ad2b2338c67443c7f77e7c5e0e91d81669536963b98f7aa4"
          },
          "mechanism": "Acute myocardial infarction can result from uncontrolled arrhythmia or present concurrently with arrhythmia.",
