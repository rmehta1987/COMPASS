      },
      "expected_direction": {
        "direction": "no_difference",
        "magnitude": null,
        "magnitude_source": null
      },
      "falsifier": "The study is powered to detect a difference of at least 8.86 percentage points in the probability of taking anti-hypertensive medications, comparing participants in the highest versus lowest quartile of PPI use duration, assuming sample size 1000, significance level 5% (two-sided), power 80%, two-proportion z-test with normal approximation, and approximately 1:1 allocation between groups.",
      "falsifier_threshold": {
        "value": 8.86,
        "unit": "percentage points",
        "comparator": ">="
      },
      "model_spec": {
        "form": "Logistic regression with binary outcome (anti-hypertensive medication use: yes/no) as the dependent variable. PPI use duration (continuous, in years) is the primary predictor of interest. Eight adjusted confounders (age, sex, race, ethnicity, weight, income, diabetes, CKD) are included as additional predictors.",
        "unit_of_analysis": "participant",
        "clustering": "Cluster-robust standard errors calculated at the community area level."
      },
      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m1:1_Q6.3",
