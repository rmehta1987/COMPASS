          },
          "mechanism": "Older age is a common cause of both increased PPI use (higher GERD prevalence) and anti-hypertensive medication use (higher hypertension prevalence and cardiovascular disease burden).",
          "justification": "Age is a fundamental confounder associating with both exposure and outcome independently of any causal relationship between them.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.3",
            "quoted_wording": "sha256:1502a55645513419f8997fa1a3261928116635487d10c83882c7b7ce91cc61fa"
          },
          "mechanism": "Sex differences exist in GERD prevalence and treatment patterns; sex differences also exist in hypertension prevalence, diagnosis rates, and medication use patterns.",
          "justification": "Sex confounds the association between PPI use and anti-HTN med use.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.10",
            "quoted_wording": "sha256:780728bf35035558d044eb83b0a0913fa9ac23432800ba7771332210ddb7cedd"
          },
          "mechanism": "Racial differences in hypertension prevalence and anti-hypertensive medication initiation and adherence; race as a proxy for structural exposure to differences in healthcare access, quality, and discrimination affecting both GI and cardiovascular health outcomes.",
          "justification": "Race is associated with medication use patterns and health system engagement across conditions.",
          "role": "proxy",
          "proxy_for": "structural exposure to differential healthcare access and residential investment",
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.8",
            "quoted_wording": "sha256:a10a496fc05ed9ee27e352d585b73564c6380fa93220d96d5bb1bf12b34e95e6"
          },
          "mechanism": "Ethnicity differences in health literacy, healthcare access, language concordance with providers, and medication use behaviors for both GI and cardiovascular conditions.",
          "justification": "Hispanic/Latino ethnicity is associated with medication use patterns through healthcare access and engagement pathways.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q2.10",
            "quoted_wording": "sha256:b188718a8d8144f5fe4cf3c35a60b74088dcd97a8cf89ca2f1fec01a9af8139b"
          },
          "mechanism": "Obesity is a risk factor for both reflux disease (driving PPI use) and hypertension (driving anti-HTN medication use), through shared pathways of cardiovascular and metabolic dysfunction.",
          "justification": "Weight is a common cause of both conditions and confounds their association.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q5.4",
            "quoted_wording": "sha256:13d3548965635d4117cbd0b28b41f20541d0d0827da994eef2ca27064ff58d60"
          },
          "mechanism": "Socioeconomic position affects healthcare access, medication affordability, adherence, and health behaviors affecting both GI and cardiovascular health. Income determines access to preventive care, specialty care, and medications.",
          "justification": "Income is a fundamental confounder for medication use patterns across multiple conditions.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.6",
            "quoted_wording": "sha256:55600e24b14333ff4c2cea0d744d84df721ba906ace8329551ba8072ef427427"
          },
          "mechanism": "Type 2 Diabetes is a major risk factor for hypertension and drives anti-hypertensive medication use; diabetic patients have greater medication burden and healthcare engagement. Diabetes is not caused by PPI use.",
          "justification": "Diabetes confounds the association by being associated with the outcome (anti-HTN med use) through shared cardiovascular disease pathways.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.15#1_14",
            "quoted_wording": "sha256:bea27aead92e7ee487b9cc5e3c674115b0dd4130d8c4ac1afdcdfb86cc5a45db"
          },
          "mechanism": "CKD is bidirectionally related to hypertension (HTN causes CKD; CKD causes HTN) and strongly drives anti-hypertensive medication use as part of renal protective therapy. CKD is a marker of overall cardiovascular and metabolic disease burden.",
          "justification": "CKD is associated with anti-HTN medication use independent of PPI exposure and confounds the association.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.8",
            "quoted_wording": "sha256:54859c0b47368445f04b396a67b96ed6934dcd16cef08c3db16e3357147c596b"
          },
          "mechanism": "Hypertension diagnosis lies on the causal pathway from PPI exposure to anti-hypertensive medication use. If PPIs affect blood pressure through any mechanism (electrolyte effects, systemic inflammation, etc.), this would result in hypertension diagnosis, which then triggers medication initiation. Additionally, HTN diagnosis is nearly a necessary precursor to being prescribed anti-HTN medications, so it is on the pathway to the outcome.",
          "justification": "Adjusting for HTN diagnosis would block potential causal pathways and partition the total effect into direct and indirect components. To preserve the total effect and test whether PPI use predicts anti-HTN medication use through any pathway, HTN diagnosis is excluded.",
          "role": "mediator",
          "proxy_for": null,
          "contestable": false
        }
      ],
