      "dictionary_version": "3dc8415eccfe",
      "question": "Does earlier age at initiation of combined estrogen-progestin prescription hormones influence the amount of time individuals currently spend in occupational light-duty physical work (walking and carrying materials weighing less than 50 pounds)?",
      "exposure": {
        "kind": "variable",
        "key": "m2:Q9.91",
        "quoted_wording": "sha256:24058ea54024726b502fec609c7e382c2cb450d51a1a519020622b7770372cb2"
      },
      "outcome": {
        "kind": "variable",
        "key": "m3:Q2.6",
        "quoted_wording": "sha256:9d7173cf7e19a2185de95350e9396329a63117511a2c16b15f22a818d8c1ac58"
      },
      "expected_direction": {
        "direction": "no_difference",
        "magnitude": null,
        "magnitude_source": null
      },
      "falsifier": "A risk difference of 5.11 percentage points or greater per year of earlier hormone initiation, at n=3000, would contradict the null hypothesis under standard significance and power conventions (two-sided α=0.05, power=0.80).",
      "falsifier_threshold": {
        "value": 5.11,
        "unit": "percentage points",
        "comparator": ">="
      },
      "model_spec": {
        "form": "Risk difference regression via binomial GLM or OLS with cluster-robust standard errors",
        "unit_of_analysis": "participant",
        "clustering": "Community area"
      },
      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.10",
            "quoted_wording": "sha256:780728bf35035558d044eb83b0a0913fa9ac23432800ba7771332210ddb7cedd"
          },
          "mechanism": "Race/ethnicity is a structural determinant of healthcare access, occupational opportunity, and socioeconomic circumstances that affect both hormone initiation timing and occupational roles.",
          "justification": "Healthcare access varies by race/ethnicity through insurance coverage, provider availability, and discrimination; occupational segregation is stratified by race/ethnicity. Both pathways confound the exposure-outcome relationship.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q5.4",
            "quoted_wording": "sha256:79590ca38c808b483369e51527ceca6aca100f2472a404c51b46d36b4411c743"
          },
          "mechanism": "Socioeconomic status (SES) determines both access to preventive reproductive healthcare—where hormone prescriptions are initiated—and the range of occupational opportunities available.",
          "justification": "Higher household income is associated with earlier and easier access to contraceptive services; it also predicts occupational trajectories away from light manual labor. SES is a common cause of both exposure timing and occupational outcomes.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.7",
            "quoted_wording": "sha256:16d7eea5541bf8da230e2fb4e326b08f86bc108ca54590dbe34a047428ed7bea"
          },
          "mechanism": "Marital or partnership status shapes reproductive intentions and family planning decisions, which directly influence the timing and type of contraceptive use. Marital status also influences occupational decisions and work-life balance patterns.",
          "justification": "Unmarried or early-partnered individuals may initiate hormones at different ages based on reproductive goals; partnership status influences occupational commitment and availability for manual work.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m3:Q5.5",
            "quoted_wording": "sha256:de9dcac5ebc6d726296a67ec78524bb13c5da9982763c0234ce9ca8653cc6c0a"
          },
          "mechanism": "Current smoking status is a marker of broader health behaviors, socioeconomic status, and lifestyle factors. These same factors are associated with occupational type, physical capacity, and healthcare-seeking behavior including contraceptive access.",
          "justification": "Smoking prevalence is stratified by SES and occupational category; health behaviors cluster. Individuals with lower SES who smoke may have had different access to hormones at earlier ages and different occupational opportunities.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m3:Q15.7",
            "quoted_wording": "sha256:ed5b18e3585428555a7a752d8719073435ee873307bc6fa8ce6a726ccceb866f"
          },
          "mechanism": "Alcohol consumption patterns reflect health behaviors, social integration, SES, and occupational culture. These factors influence both access to preventive services (hormones) and engagement in manual occupational work.",
          "justification": "Alcohol use is associated with SES, occupational type, and health status—all of which confound the relationship between hormone initiation age and occupational activity.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q4.4",
            "quoted_wording": "sha256:cc80b448e0ca3c718aa3a77b88ba8ef15c9407549207a458b33edeb6355b9e62"
          },
          "mechanism": "Current job type describes the occupation that generates the outcome measure. The outcome is the time per workday spent walking and carrying light materials—a characteristic inherent to the job itself.",
          "justification": "Including job type creates post-treatment bias or confuses a component of the outcome with a confounder. The job is what produces the occupational light-duty work time being measured; it is not an independent cause of that outcome.",
          "role": "descendant_of_outcome",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q2.10",
            "quoted_wording": "sha256:b188718a8d8144f5fe4cf3c35a60b74088dcd97a8cf89ca2f1fec01a9af8139b"
          },
          "mechanism": "Combined estrogen-progestin hormones can influence weight gain over time. Weight in turn affects physical capacity and tolerance for manual labor.",
          "justification": "If early hormone use results in weight changes, which then affect occupational capacity or choice, weight is on the causal pathway. Adjusting for weight would block the effect of interest.",
          "role": "mediator",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q7.4",
            "quoted_wording": "sha256:57b4c7a3bb52e7ceb482afd32a9b1b361d747696a8d88ae55a64a2664351c6e4"
          },
          "mechanism": "Pregnancy and reproductive history are causally downstream of contraceptive choices and use. Pregnancy and parenthood then directly affect occupational engagement through physical demands of pregnancy/recovery and childcare responsibilities.",
          "justification": "The decision to use hormones shapes reproductive outcomes over the life course. Those outcomes (number of pregnancies, timing of births) are then determinants of current occupational activity. Adjustment would eliminate a mechanism through which early hormone use might affect occupational outcomes.",
          "role": "mediator",
          "proxy_for": null,
          "contestable": false
        }
      ],
