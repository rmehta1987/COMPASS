      "dictionary_version": "3dc8415eccfe",
      "question": "Does initiation of prescription hormone use at an earlier age hasten or delay the age at which someone receives a chronic bronchitis diagnosis?",
      "exposure": {
        "kind": "variable",
        "key": "m2:Q9.97",
        "quoted_wording": "sha256:510000d63574342e7d44576c8118a2ec6ce352ac943c7bfd9dac4bf5088e6933"
      },
      "outcome": {
        "kind": "variable",
        "key": "m2:Q5.27",
        "quoted_wording": "sha256:3372ae4c72af2c42e8252381dbb3e3f82243066f2635958eb188ed265bf13f56"
      },
      "expected_direction": {
        "direction": "increase",
        "magnitude": null,
        "magnitude_source": null
      },
      "falsifier": "The study falsifies the hypothesis if the regression coefficient for age at hormone use initiation (in years) falls between approximately −2.0 and +2.0 years change per year of later hormone initiation, accounting for uncertainty. Equivalently, the study falsifies the hypothesis if the correlation between age at hormone initiation and age at diagnosis is close to zero with a narrow confidence interval. Stated in units of the outcome: the study falsifies the hypothesis if a 10-year difference in hormone use initiation age is associated with less than ±5 years' difference in bronchitis diagnosis age (or a relationship indistinguishable from zero).",
      "falsifier_threshold": null,
      "model_spec": {
        "form": "Linear regression of age at bronchitis diagnosis (m2:Q5.27) on age at hormone use initiation (m2:Q9.97), with the six adjusted covariates entered as main effects.",
        "unit_of_analysis": "participant",
        "clustering": "no clustering: exposure does not vary by place"
      },
      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.3",
            "quoted_wording": "sha256:1502a55645513419f8997fa1a3261928116635487d10c83882c7b7ce91cc61fa"
          },
          "mechanism": "Sex at birth determines the probability and timing of hormone prescriptions (e.g., female-oriented hormones prescribed more frequently to those assigned female at birth). Sex also affects biological susceptibility to respiratory disease and possibly healthcare-seeking patterns related to respiratory symptoms.",
          "justification": "Confounding through common cause of both exposure (determines hormone prescribing patterns) and outcome (affects bronchitis risk through biological and behavioral pathways).",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m3:Q5.2",
            "quoted_wording": "sha256:49462d083aa17652e16143a763ac5e1b805c061e73ec8ed2cc74bd70b41b2fd1"
          },
          "mechanism": "Smoking is the leading modifiable risk factor for chronic bronchitis. Individuals who begin smoking at younger ages have more cumulative exposure and higher bronchitis risk. Smoking initiation may be correlated with hormone use patterns through shared socioeconomic and behavioral risk factors.",
          "justification": "Confounding through a common cause of outcome (directly causes bronchitis) and possible association with exposure through socioeconomic pathways.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.2",
            "quoted_wording": "sha256:e672fe3877afaccf4fdb8494eb3a52b9b49409338fc5e962bf41e697ec74fbfb"
          },
          "mechanism": "Asthma increases the susceptibility to chronic bronchitis through pre-existing airway inflammation and compromised respiratory function. Individuals with asthma may also have higher rates of hormone use due to medical management of other conditions or comorbidities.",
          "justification": "Confounding through a common cause of outcome (increases bronchitis risk) and possible association with exposure (medical complexity that increases hormone prescriptions).",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.10",
            "quoted_wording": "sha256:780728bf35035558d044eb83b0a0913fa9ac23432800ba7771332210ddb7cedd"
          },
          "mechanism": "Race/ethnicity functions as a proxy for structural exposure to residential disinvestment, environmental hazards, and differential healthcare access in Chicago. These pathways affect both the probability of hormone prescriptions (through healthcare access) and the risk of bronchitis diagnosis (through environmental exposure and healthcare utilization).",
          "justification": "Confounding through structural determinants of both exposure access and outcome risk, mediated through environmental exposures and healthcare patterns.",
          "role": "proxy",
          "proxy_for": "structural exposure to residential disinvestment and differential healthcare access",
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q5.4",
            "quoted_wording": "sha256:79590ca38c808b483369e51527ceca6aca100f2472a404c51b46d36b4411c743"
          },
          "mechanism": "Household income affects access to prescription medications (including hormones) and access to healthcare for respiratory diagnosis. Lower income increases exposure to environmental risk factors for bronchitis (air quality, occupational hazards, housing conditions). Income also affects healthcare-seeking behavior and symptom reporting.",
          "justification": "Confounding through multiple causal pathways to both exposure (access to prescriptions) and outcome (access to diagnosis, environmental risk exposure).",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q2.2",
            "quoted_wording": "sha256:e83a2c35edfd30f2ea3f17c0b6baf7cdf5f2a7d34ed56f0fa0780a6749a21bba"
          },
          "mechanism": "Insurance type determines access to prescription medications and regular healthcare for chronic disease diagnosis. Insurance affects both the probability of receiving hormone prescriptions and the probability of being screened for and diagnosed with bronchitis.",
          "justification": "Confounding through access pathways to both exposure (prescription medications) and outcome (healthcare diagnosis).",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q4.2",
            "quoted_wording": "sha256:339d1229b24865d32dcf91bbafc331feddedd6d6df1c7e3e42da80c95151a768"
          },
          "mechanism": "Current work status is neither a direct cause of the age at which someone initiated hormone use in the past, nor a direct cause of the age at which someone was diagnosed with bronchitis. While chronic bronchitis can affect current employment, employment status does not causally determine either the exposure or the outcome age measured retrospectively.",
          "justification": "This variable is not a cause of either the exposure or the outcome. Excluding it reduces adjustment set complexity without introducing omitted variable bias.",
          "role": "not_a_cause_of_either",
          "proxy_for": null,
          "contestable": false
        }
      ],
