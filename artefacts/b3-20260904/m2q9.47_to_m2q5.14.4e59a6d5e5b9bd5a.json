          },
          "mechanism": "Statin use is a direct treatment consequence of being diagnosed with high cholesterol.",
          "justification": "Statin use is a direct treatment consequence of being diagnosed with high cholesterol. This is clearly a descendant of the outcome and should not be adjusted for, as it would condition away part of the outcome.",
          "role": "descendant_of_outcome",
          "proxy_for": null,
          "contestable": false
        }
