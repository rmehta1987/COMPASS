          },
          "mechanism": "Proxy for both age (core demographic confounder) and menopausal status.",
          "justification": "Age is a fundamental confounder predicting both menopausal hormone use (most users are ages 40-60) and cholesterol levels (increases with age). Age at most recent menstrual period approximates current age for perimenopausal/menopausal women and identifies menopausal status (eligibility criterion for menopausal hormone therapy). Direct current age variable could not be resolved from the instrument; this question serves as a proxy for participant age and menopause status.",
          "role": "proxy",
          "proxy_for": "Current participant age and menopausal status",
          "contestable": false
        }
