      "dictionary_version": "3dc8415eccfe",
      "question": "Does the outcome of a woman's first pregnancy affect the age at which she is first diagnosed with migraine?",
      "exposure": {
        "kind": "variable",
        "key": "m2:1_Q8.3",
        "quoted_wording": "sha256:86e7b1a404f1397a341bf901f5dc8156dd85c1836b6ec839329da794fefaa6bc"
      },
      "outcome": {
        "kind": "variable",
        "key": "m2:Q5.53",
        "quoted_wording": "sha256:6aee6ec5a86d1e1808a5d2e1270363d473b6cb7a90a7aae5c35785422f9c7a35"
      },
      "expected_direction": {
        "direction": "no_difference",
        "magnitude": null,
        "magnitude_source": null
      },
      "falsifier": "Adverse first pregnancy outcome is associated with a mean difference of at least 3 years in age at migraine diagnosis compared to live birth.",
      "falsifier_threshold": null,
      "model_spec": {
        "form": "Linear regression of age at migraine diagnosis on pregnancy outcome, adjusted for the three confounders and with standard errors clustered by geographic community area.",
        "unit_of_analysis": "participant",
        "clustering": "Community area"
      },
      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:1_Q8.2",
            "quoted_wording": "sha256:7aa32c085b36a832cb7d79c3a3b28957e1061c26d80d122f51316f5f4bc93d4c"
          },
          "mechanism": "Maternal age at first pregnancy causally influences pregnancy outcomes (older maternal age increases risk of miscarriage, stillbirth, and other complications). Maternal age is also correlated with current age and life stage, both of which independently affect the timing of any health diagnosis.",
          "justification": "Confounding—age at first pregnancy is a proxy for overall maternal age and reproductive life stage, each of which independently relates to the opportunity and likelihood of migraine diagnosis at various ages.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.10",
            "quoted_wording": "sha256:780728bf35035558d044eb83b0a0913fa9ac23432800ba7771332210ddb7cedd"
          },
          "mechanism": "Race/ethnicity relates to both pregnancy outcomes (through differences in maternal health status, healthcare access, and clinical decision-making) and migraine diagnosis (through differences in migraine prevalence, symptom attribution, and access to specialist care).",
          "justification": "Confounding—racial and ethnic groups differ systematically in both adverse pregnancy outcome rates and in migraine recognition and diagnosis.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q5.4",
            "quoted_wording": "sha256:79590ca38c808b483369e51527ceca6aca100f2472a404c51b46d36b4411c743"
          },
          "mechanism": "Household income reflects socioeconomic status, which causally influences both pregnancy complications (through access to prenatal care, nutrition, stress levels) and the timing of migraine diagnosis (through access to primary and specialist healthcare, ability to pursue medical evaluation).",
          "justification": "Confounding—SES is a fundamental cause affecting both exposure and outcome through multiple pathways.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.15#1_38",
            "quoted_wording": "sha256:1467942cbe1963a5c566346e27265166a6386f2458f9c85783a94759dbb045ba"
          },
          "mechanism": "This variable is a binary indicator of whether the participant has ever been diagnosed with migraine.",
          "justification": "Descendant of outcome—this is a collapsed or dichotomous version of the outcome variable itself (age at migraine diagnosis). Including it as a covariate would condition on the outcome, biasing estimates.",
          "role": "descendant_of_outcome",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "undetermined_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.30",
            "quoted_wording": "sha256:1b3efc7594d0cc4d06035229a893f6e98f899e0e4a4c97c79830a2e86d15b990"
          },
          "mechanism": "Depression could be a confounder if it predates pregnancy (depression predisposes to both adverse pregnancy outcomes and increased migraine risk). Alternatively, depression could be a mediator if pregnancy complications trigger depression, which then affects migraine risk. Or depression could develop after both exposure and outcome and be unrelated.",
          "justification": "Without temporal sequence data showing whether depression onset preceded, coincided with, or followed the pregnancy and migraine diagnosis, the causal role cannot be determined.",
          "role": "confounder_or_mediator",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q5.18",
            "quoted_wording": "sha256:9b99356b9e919aeea0d6bf9fcc84627f9f8cb7128bf188cd97c33abc5ded3191"
          },
          "mechanism": "Anxiety disorders could confound the relationship (if pre-pregnancy), mediate it (if caused by pregnancy complications), or be unrelated, depending on timing.",
          "justification": "Temporal sequencing unknown—the causal position of anxiety relative to pregnancy outcome and migraine diagnosis cannot be established from these questions alone.",
          "role": "confounder_or_mediator",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q9.36",
            "quoted_wording": "sha256:477be3f46751accc9ccc672d67be3ba99a33a4d33362d3e3bd1d97da1293aeca"
          },
          "mechanism": "Oral contraceptive pills deliver exogenous estrogen, which independently affects migraine risk and prevalence. However, the timing of OCP use relative to the pregnancy and migraine diagnosis is not specified: OCP use could predate pregnancy (confounding), occur between pregnancy outcome and migraine diagnosis (potentially mediating or independently causative), or postdate migraine diagnosis (irrelevant).",
          "justification": "Without knowing when OCP use occurred in the participant's timeline, the causal role cannot be determined.",
          "role": "confounder_or_mediator",
          "proxy_for": null,
          "contestable": false
        }
      ],
