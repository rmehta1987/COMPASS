      "question": "Does unmet medical need in the past 12 months increase the risk of having a lifetime diagnosis of uterine fibroids?",
      "exposure": {
        "kind": "variable",
        "key": "m2:Q4.9",
        "quoted_wording": "sha256:b9e7ea971d71e9dd4adc7e1838784ef70b9088e877704a71be28a01217003e81"
      },
      "outcome": {
        "kind": "variable",
        "key": "m2:Q9.117",
        "quoted_wording": "sha256:ca5c6a7868bd606db7b340f1cbb34a0e25b626e068259b8333026e139de1ddae"
      },
      "expected_direction": {
        "direction": "decrease",
        "magnitude": null,
        "magnitude_source": null
      },
      "falsifier": "A risk difference of 8.86 percentage points or larger between those with unmet medical need and those with met medical need. That is, if the proportion diagnosed with uterine fibroids among those with unmet need differs from those with met need by 8.86 percentage points or more, the null hypothesis (no association) would be rejected at the environment-specified significance and power.",
      "falsifier_threshold": {
        "value": 8.86,
        "unit": "percentage points",
        "comparator": ">="
      },
      "model_spec": {
        "form": "Logistic regression with unmet medical need as the primary predictor, adjusted for race, ethnicity, education, and household income. The outcome is binary (diagnosed with fibroids: yes/no).",
        "unit_of_analysis": "participant",
        "clustering": "Community area level clustering with unknown design effect"
      },
      "adjusted_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.11",
            "quoted_wording": "sha256:45f00b152c1b85953fc15fb60065f1ca1ffffc566a72d7902ecca4f602786ef1"
          },
          "mechanism": "Education is a marker of socioeconomic position and correlates with healthcare access (affects likelihood of unmet need) and overall health outcomes (affects fibroids diagnosis through healthcare-seeking behavior and access to diagnosis).",
          "justification": "This is a confounder—it influences both the exposure (higher education typically associated with better healthcare access and lower unmet need) and the outcome (education affects healthcare utilization and likelihood of receiving a diagnosis).",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.10",
            "quoted_wording": "sha256:780728bf35035558d044eb83b0a0913fa9ac23432800ba7771332210ddb7cedd"
          },
          "mechanism": "Race/ethnicity is associated with healthcare access disparities and variation in prevalence of uterine fibroids across racial groups, independent of actual medical need.",
          "justification": "Documented racial disparities exist in both healthcare access (affecting unmet need) and in fibroids prevalence and detection rates. Race is not caused by either exposure or outcome.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q3.8",
            "quoted_wording": "sha256:a10a496fc05ed9ee27e352d585b73564c6380fa93220d96d5bb1bf12b34e95e6"
          },
          "mechanism": "Hispanic/Latino ethnicity is associated with both healthcare access barriers (affecting unmet need) and distinct patterns of health outcomes including fibroids diagnosis.",
          "justification": "Ethnic disparities in healthcare access and health outcomes are well-documented. Hispanic/Latino ethnicity is an independent confounder.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m1:Q5.4",
            "quoted_wording": "sha256:13d3548965635d4117cbd0b28b41f20541d0d0827da994eef2ca27064ff58d60"
          },
          "mechanism": "Income directly influences access to healthcare and ability to obtain care when needed (affects unmet need), and also affects access to diagnosis and preventive care (affects outcome likelihood).",
          "justification": "Household income is a classic confounder in health disparities research—it directly affects both healthcare access and health outcomes.",
          "role": "confounder",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q9.104",
            "quoted_wording": "sha256:e770648a9d0b1b81410fba79beaa830081a58ae6bcab245a1745d353222efe71"
          },
          "mechanism": "Hysterectomy is often performed as treatment for fibroids or related conditions. It lies on the causal pathway downstream of the outcome (fibroids diagnosis) or represents a consequence of fibroids-related treatment.",
          "justification": "Hysterectomy is a descendant of the outcome. It is not a cause of unmet medical need, and including it would block the path from outcome to exposure. Inclusion would bias estimates toward null.",
          "role": "descendant_of_outcome",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q9.114",
            "quoted_wording": "sha256:b53e805b7b97d529a5b03b2b411aad95a64b4c3cc3613de2269cb9647e75ceb8"
          },
          "mechanism": "Endometriosis is a separate gynecological condition with overlapping symptoms to fibroids but no direct causal relationship to unmet medical need. While both are gynecological diagnoses that may share some diagnostic pathways, endometriosis is not a cause of the exposure (unmet need).",
          "justification": "Endometriosis is not a cause of either exposure or outcome in the causal model. It is an independent condition that may be diagnosed concurrently but does not generate unmet medical need or cause fibroids.",
          "role": "not_a_cause_of_either",
          "proxy_for": null,
          "contestable": false
        },
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q9.119",
            "quoted_wording": "sha256:027d98f627b87e78253e282ede8e2f921f045af728419450c34bdf5483a29869"
          },
          "mechanism": "PCOS is a distinct endocrine disorder unrelated to unmet medical need and not causally related to fibroids diagnosis.",
          "justification": "PCOS is not a cause of either the exposure (unmet medical need) or the outcome (fibroids). It represents a separate condition that should be excluded to maintain causal focus.",
          "role": "not_a_cause_of_either",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "undetermined_covariates": [
        {
          "variable": {
            "kind": "variable",
            "key": "m2:Q2.2",
            "quoted_wording": "sha256:e83a2c35edfd30f2ea3f17c0b6baf7cdf5f2a7d34ed56f0fa0780a6749a21bba"
          },
          "mechanism": "Health insurance status could be a confounder (independently affects access to care and likelihood of receiving diagnosis) or could lie on the causal pathway from socioeconomic status (income/education) to unmet need to fibroids diagnosis (mediator).",
          "justification": "Insurance status is causally complex. Higher income and education predict insurance coverage, which predicts access to care and diagnosis. Insurance could thus be on the pathway from SES to unmet need, making it a potential mediator. Alternatively, insurance status could represent an independent barrier to access not fully captured by income. One questionnaire cannot establish temporal order or separate direct from indirect effects. The question asks about current coverage without temporal relationship to the exposure (past 12 months) or outcome (lifetime diagnosis), making causal interpretation uncertain.",
          "role": "unadjudicated",
          "proxy_for": null,
          "contestable": false
        }
      ],
