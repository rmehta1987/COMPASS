            "quoted_wording": "sha256:78f1b457e03efe3e110fcde99b6c94dcc7b83e3de0d6d9f1a4c6c56cb711ff57"
          },
          "mechanism": "This is a downstream consequence of hypertension diagnosis and represents healthcare intervention after the outcome of interest.",
          "justification": "Adjustment for treatment status would condition on a post-exposure outcome and introduce collider bias. Those diagnosed are more likely to be treated; excluding those not treated would distort the relationship between insurance and diagnosis.",
          "role": "descendant_of_outcome",
          "proxy_for": null,
          "contestable": false
        },
        {
