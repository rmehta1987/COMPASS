      "expected_direction": {
        "direction": "no_difference",
        "magnitude": null,
        "magnitude_source": null
      },
      "falsifier": "The study would falsify the hypothesis of no association if it detects a risk difference in hypertension diagnosis probability of 9.0 percentage points or greater (or greater in absolute magnitude) between insurance coverage groups.",
      "falsifier_threshold": {
        "value": 9.0,
        "unit": "percentage points",
        "comparator": ">="
      },
      "model_spec": {
        "form": "Logistic regression with binary outcome (hypertension diagnosis: yes/no) regressed on insurance coverage category, adjusted for confounders listed above",
        "unit_of_analysis": "participant",
        "clustering": "Community area-level; cluster-robust standard errors required by design convention; design effect not yet computed"
      },
      "adjusted_covariates": [
