          },
          "mechanism": "Weight is a proxy for overall health status and BMI, which is a direct risk factor for hypertension.",
          "justification": "Weight/BMI is a direct risk factor for hypertension and a measure of health status.",
          "role": "precision",
          "proxy_for": null,
          "contestable": false
        }
      ],
      "excluded_variables": [
        {
          "variable": {
            "kind": "variable",
